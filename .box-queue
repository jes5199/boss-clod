#       [ -z "$hpid" ] && { echo "BLIND: cannot resolve hermes MainPID"; exit 2; }
#       # ⛔ chit: DO NOT USE A POSITIONAL FIELD. `$2=="beam.smp"` is correct only for THIS -eo format;
#       #   the index is a property of the format, not of ps. A door that keeps the awk and changes
#       #   the format gets beams=0 — AND 0 IS THE VALUE THAT SAYS TAKE THE BOX. `tot` does not catch
#       #   it, because ps worked fine. Match in ANY field: looser, and an argv containing the literal
