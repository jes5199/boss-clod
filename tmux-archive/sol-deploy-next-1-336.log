@@ -0,0 +1,209 @@
+#!/usr/bin/env node
+
+import http from "node:http";
+
+const port = Number.parseInt(process.argv[2] ?? "18080", 10);
+if (!Number.isInteger(port) || port < 1 || port > 65535) {
+  throw new TypeError("port must be an integer from 1 through 65535");
+}
+
+const logs = new Map();
+let writerSequence = 1;
+let arrivalSequence = 1;
+
+function json(response, status, value) {
+  const body = JSON.stringify(value);
+  response.writeHead(status, {
+    "content-type": "application/json",
+    "content-length": Buffer.byteLength(body),
+  });
+  response.end(body);
+}
+
+function ok(response, status, value = {}) {
+  json(response, status, { ok: true, ...value });
+}
+
+function error(response, status, code) {
+  json(response, status, { ok: false, error: { code } });
+}
+
+function logFor(response, logId) {
+  const log = logs.get(logId);
+  if (log === undefined) error(response, 404, "not_found");
+  return log;
+}
+
+function uuid(sequence) {
+  return `00000000-0000-4000-8000-${sequence.toString(16).padStart(12, "0")}`;
+}
+
+function createLog(response, payload) {
+  if (logs.has(payload.log_id)) return error(response, 409, "constraint_violati
on");
+  logs.set(payload.log_id, {
+    revision: 0,
+    leaseEpoch: 0,
+    documentWriterId: null,
+    entries: new Map(),
+    tips: new Map(),
+  });
+  ok(response, 201);
+}
+
+function takeLease(response, payload) {
+  const log = logFor(response, payload.log_id);
+  if (log === undefined) return;
+  log.leaseEpoch += 1;
+  log.documentWriterId = uuid(writerSequence++);
+  ok(response, 200, {
+    lease_epoch: log.leaseEpoch,
+    writer_id: log.documentWriterId,
+  });
+}
+
+function readSet(response, payload) {
+  const log = logFor(response, payload.log_id);
+  if (log === undefined) return;
+
+  const wantedWriters = new Set(payload.writers ?? []);
+  const tips = [...log.tips.values()]
+    .filter((tip) => wantedWriters.has(tip.writer_id))
+    .sort((left, right) => left.writer_id.localeCompare(right.writer_id));
+
+  const coordinates = (payload.coordinates ?? []).flatMap((coordinate) => {
+    const row = [...log.entries.values()].find(
+      (entry) =>
+        entry.writer_id === coordinate.writer_id && entry.writer_seq === coordi
nate.writer_seq,
+    );
+    return row === undefined
+      ? []
+      : [{ ...coordinate, canonical_bytes: row.canonical_bytes }];
+  });
+
+  const entryIds = (payload.entry_ids ?? []).flatMap((entryId) => {
+    const row = log.entries.get(entryId);
+    return row === undefined
+      ? []
+      : [{ entry_id: entryId, canonical_bytes: row.canonical_bytes }];
+  });
+
+  ok(response, 200, {
+    read_set: {
+      log_id: payload.log_id,
+      format_version: 1,
+      revision: log.revision,
+      lease_epoch: log.leaseEpoch,
+      document_writer_id: log.documentWriterId,
+      tips,
+      coordinates,
+      entry_ids: entryIds,
+    },
+  });
+}
+
+function commit(response, payload) {
+  const log = logFor(response, payload.log_id);
+  if (log === undefined) return;
+  if (payload.expected_revision !== log.revision) return error(response, 409, "
stale_revision");
+  if (payload.expected_epoch !== log.leaseEpoch) return error(response, 409, "o
bsolete_epoch");
+
+  for (const entry of payload.insert_entries ?? []) {
+    const existing = log.entries.get(entry.entry_id);
+    if (existing !== undefined && existing.canonical_bytes !== entry.canonical_
bytes) {
+      return error(response, 409, "constraint_violation");
+    }
+  }
+
+  for (const entry of payload.insert_entries ?? []) {
+    if (!log.entries.has(entry.entry_id)) {
+      log.entries.set(entry.entry_id, { ...entry, arrival_seq: arrivalSequence+
+ });
+    }
+  }
+  for (const tip of payload.put_tips ?? []) log.tips.set(tip.writer_id, tip);
+  log.revision += 1;
+  ok(response, 200, { revision: log.revision });
+}
+
+function frontier(response, payload) {
+  const log = logFor(response, payload.log_id);
+  if (log === undefined) return;
+  const writers = [...log.tips.values()]
+    .map((tip) => ({ writer_id: tip.writer_id, seq: tip.last_seq, entry_id: tip
.last_entry_id }))
+    .sort((left, right) => left.writer_id.localeCompare(right.writer_id));
+  ok(response, 200, { frontier: { writers } });
+}
+
+function readWriter(response, payload) {
+  const log = logFor(response, payload.log_id);
+  if (log === undefined) return;
+  const entries = [...log.entries.values()]
+    .filter(
+      (entry) =>
+        entry.writer_id === payload.writer_id &&
+        entry.writer_seq > payload.after_seq &&
+        (payload.through_seq == null || entry.writer_seq <= payload.through_seq
),
+    )
+    .sort((left, right) => left.writer_seq - right.writer_seq)
+    .slice(0, payload.limit)
+    .map((entry) => ({ canonical_bytes: entry.canonical_bytes, writer_seq: entr
y.writer_seq }));
+  ok(response, 200, {
+    page: {
+      entries,
+      next_after_seq: entries.length === payload.limit ? entries.at(-1).writer_
seq : null,
+    },
+  });
+}
+
+function tailLocal(response, payload) {
+  const log = logFor(response, payload.log_id);
+  if (log === undefined) return;
+  const entries = [...log.entries.values()]
+    .filter((entry) => entry.arrival_seq > payload.after_arrival)
+    .sort((left, right) => left.arrival_seq - right.arrival_seq)
+    .slice(0, payload.limit)
+    .map((entry) => ({ canonical_bytes: entry.canonical_bytes, arrival_seq: ent
ry.arrival_seq }));
+  ok(response, 200, {
+    page: {
+      entries,
+      next_after_arrival: entries.length === payload.limit ? entries.at(-1).arr
ival_seq : null,
+    },
+  });
+}
+
+const routes = new Map([
+  ["/create-log", createLog],
+  ["/take-lease", takeLease],
+  ["/read-set", readSet],
+  ["/commit", commit],
+  ["/frontier", frontier],
+  ["/read-writer", readWriter],
+  ["/tail-local", tailLocal],
+]);
+
+const server = http.createServer((request, response) => {
+  const url = new URL(request.url, "http://stub.invalid");
+  if (request.method === "GET" && url.pathname === "/health") return ok(respons
e, 200);
+  if (request.method === "GET" && url.pathname === "/jwks") {
+    return json(response, 200, { keys: [] });
+  }
+
+  const route = routes.get(url.pathname);
+  if (request.method !== "POST" || route === undefined) {
+    return error(response, 404, "not_found");
+  }
+
+  const chunks = [];
+  request.on("data", (chunk) => chunks.push(chunk));
+  request.on("end", () => {
+    try {
+      route(response, JSON.parse(Buffer.concat(chunks).toString("utf8")));
+    } catch (_error) {
+      error(response, 400, "malformed_request");
+    }
+  });
+});
+
+server.listen(port, "0.0.0.0", () => {
+  process.stdout.write(`store stub listening on ${port}\n`);
+});
+
