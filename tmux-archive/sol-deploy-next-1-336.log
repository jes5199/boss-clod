+#!/usr/bin/env bash
+set -euo pipefail
+
+A5_IMAGE="${A5_IMAGE:-commonplace-next:2594dc7}"
+A5_STUB_PORT="${A5_STUB_PORT:-18080}"
+A5_RUN_ID="a5-${$}"
+A5_TMP_DIR="$(mktemp -d /tmp/commonplace-next-a5.XXXXXX)"
+A5_NEGATIVE_NAME="commonplace-next-${A5_RUN_ID}-negative"
+A5_POSITIVE_NAME="commonplace-next-${A5_RUN_ID}-positive"
+
+cleanup() {
+  docker rm -f "$A5_NEGATIVE_NAME" "$A5_POSITIVE_NAME" >/dev/null 2>&1 || true
+  if [[ -n "${A5_STUB_PID:-}" ]]; then kill "$A5_STUB_PID" >/dev/null 2>&1 || t
rue; fi
+  rm -rf "$A5_TMP_DIR"
+}
+trap cleanup EXIT
+
+common_env=(
+  -e SECRET_KEY_BASE=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
aaaaaa
+  -e COMMONPLACE_ACCESS_ISSUER=https://access.invalid
+  -e COMMONPLACE_ACCESS_AUDIENCE=local-a5-audience
+  -e 'COMMONPLACE_ACCESS_ROSTER={"00000000-0000-4000-8000-000000000001":"local-
reviewer"}'
+)
+
+echo 'A5 negative control: no sidecar (failure required)'
+set +e
+docker run --name "$A5_NEGATIVE_NAME" \
+  "${common_env[@]}" \
+  -e COMMONPLACE_ACCESS_JWKS_URI=http://127.0.0.1:9/jwks \
+  "$A5_IMAGE" >"$A5_TMP_DIR/negative.log" 2>&1
+A5_NEGATIVE_STATUS=$?
+set -e
+cat "$A5_TMP_DIR/negative.log"
+if [[ "$A5_NEGATIVE_STATUS" -eq 0 ]]; then
+  echo 'A5 negative control unexpectedly succeeded' >&2
+  exit 1
+fi
+grep -F 'storage.internal' "$A5_TMP_DIR/negative.log" | grep -F ':nxdomain' >/d
ev/null
+grep -F 'failed to start child CommonplaceNext.Realm' "$A5_TMP_DIR/negative.log
" >/dev/null
+
+echo 'A5 arm: local seven-route sidecar (success required)'
+node test/support/store-stub.mjs "$A5_STUB_PORT" >"$A5_TMP_DIR/stub.log" 2>&1 &
+A5_STUB_PID=$!
+for _attempt in $(seq 1 50); do
+  if curl --silent --fail "http://127.0.0.1:${A5_STUB_PORT}/health" >/dev/null;
 then break; fi
+  sleep 0.1
+done
+curl --silent --fail "http://127.0.0.1:${A5_STUB_PORT}/health" >/dev/null
+cat "$A5_TMP_DIR/stub.log"
+
+docker run --detach --name "$A5_POSITIVE_NAME" \
+  --add-host host.docker.internal:host-gateway \
+  --publish 127.0.0.1::4000 \
+  "${common_env[@]}" \
+  -e COMMONPLACE_ACCESS_JWKS_URI="http://host.docker.internal:${A5_STUB_PORT}/j
wks" \
+  -e COMMONPLACE_SIDECAR_URL="http://host.docker.internal:${A5_STUB_PORT}" \
+  "$A5_IMAGE" >/dev/null
+
+A5_HOST_PORT="$(docker port "$A5_POSITIVE_NAME" 4000/tcp | sed -n 's/.*://p')"
+for _attempt in $(seq 1 300); do
+  if [[ "$(docker inspect "$A5_POSITIVE_NAME" --format '{{.State.Running}}')" !
= true ]]; then
+    docker logs "$A5_POSITIVE_NAME"
+    echo 'A5 positive container stopped before becoming reachable' >&2
+    exit 1
+  fi
+  if curl --silent --output /dev/null "http://127.0.0.1:${A5_HOST_PORT}/"; then
+    docker logs "$A5_POSITIVE_NAME"
+    echo 'A5 arm passed: stub reachable, container running, application HTTP en
dpoint reachable'
+    exit 0
+  fi
+  sleep 0.1
+done
+
+docker logs "$A5_POSITIVE_NAME"
+echo 'A5 positive container never became reachable' >&2
+exit 1
+
