d2e8a197
--- /dev/null
+++ b/worker/src/outbound.js
@@ -0,0 +1,74 @@
+const STORAGE_HOST = "storage.internal";
+
+function textResponse(status, body) {
+  return new Response(body, {
+    status,
+    headers: { "content-type": "text/plain; charset=utf-8" },
+  });
+}
+
+function forbidden() {
+  return textResponse(403, "forbidden");
+}
+
+function upstreamUnavailable() {
+  return textResponse(502, "storage upstream unavailable");
+}
+
+function targetUrl(incomingUrl, configuredEndpoint) {
+  if (typeof configuredEndpoint !== "string" || configuredEndpoint.trim() === "
") {
+    throw new TypeError("COMMONPLACE_LOG_REALM_URL is absent");
+  }
+
+  const base = new URL(configuredEndpoint);
+  if (base.protocol !== "https:") {
+    throw new TypeError("COMMONPLACE_LOG_REALM_URL must use HTTPS");
+  }
+
+  const target = new URL(base);
+  const basePath = base.pathname.replace(/\/$/, "");
+  target.pathname = `${basePath}${incomingUrl.pathname}`;
+  target.search = incomingUrl.search;
+  target.hash = "";
+  return target;
+}
+
+/**
+ * Build the outbound handler around an injectable transport. Production uses
+ * global fetch; tests use a recorder and never need a credential or network.
+ */
+export function createStorageInternal(transport = globalThis.fetch) {
+  return async function storageInternal(request, env, _ctx) {
+    const incomingUrl = new URL(request.url);
+
+    // This check must precede every binding read and every transport call.
+    if (incomingUrl.hostname !== STORAGE_HOST) return forbidden();
+
+    let forwarded;
+    try {
+      const capability = env.COMMONPLACE_LOG_REALM_CAPABILITY;
+      if (typeof capability !== "string" || capability.trim() === "") {
+        return upstreamUnavailable();
+      }
+
+      const target = targetUrl(incomingUrl, env.COMMONPLACE_LOG_REALM_URL);
+      forwarded = new Request(target, request);
+
+      // An authorization chosen inside the container is untrusted. Remove it
+      // before installing the only authority this lane accepts: our secret.
+      forwarded.headers.delete("authorization");
+      forwarded.headers.set("authorization", `Bearer ${capability}`);
+    } catch (_error) {
+      return upstreamUnavailable();
+    }
+
+    try {
+      return await transport(forwarded);
+    } catch (_error) {
+      // Do not stringify the error: transports may include request details.
+      return upstreamUnavailable();
+    }
+  };
+}
+
+export const storageInternal = createStorageInternal();
