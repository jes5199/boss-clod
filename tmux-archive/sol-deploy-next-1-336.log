+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+
+import { createStorageInternal } from "../src/outbound.js";
+
+const FAKE_SECRET = "fake-capability-positive-control-7f15";
+const ENV = {
+  COMMONPLACE_LOG_REALM_URL: "https://commonplace-log.example",
+  COMMONPLACE_LOG_REALM_CAPABILITY: FAKE_SECRET,
+};
+
+function post(url, authorization = undefined) {
+  const headers = { "content-type": "application/json" };
+  if (authorization !== undefined) headers.authorization = authorization;
+  return new Request(url, { method: "POST", headers, body: "{}" });
+}
+
+test("A1 control: storage.internal reaches the injected transport", async () =>
 {
+  let calls = 0;
+  const handler = createStorageInternal(async () => {
+    calls += 1;
+    return new Response(null, { status: 204 });
+  });
+
+  assert.equal((await handler(post("http://storage.internal/frontier"), ENV, {}
)).status, 204);
+  assert.equal(calls, 1);
+});
+
+test("A1: every non-storage hostname is 403 and is never forwarded", async () =
> {
+  let calls = 0;
+  const handler = createStorageInternal(async () => {
+    calls += 1;
+    return new Response(null, { status: 204 });
+  });
+
+  for (const url of [
+    "http://storage.internal.example/frontier",
+    "http://example.test/frontier",
+    "http://127.0.0.1/frontier",
+  ]) {
+    const response = await handler(post(url), ENV, {});
+    assert.equal(response.status, 403);
+    assert.equal(await response.text(), "forbidden");
+  }
+  assert.equal(calls, 0);
+});
+
+test("A2: the secret capability replaces container-supplied authorization", asy
nc () => {
+  let outgoing;
+  const handler = createStorageInternal(async (request) => {
+    outgoing = request;
+    return new Response(null, { status: 204 });
+  });
+
+  const response = await handler(
+    post("http://storage.internal/commit", "Bearer container-chosen-authority")
,
+    ENV,
+    {},
+  );
+
+  assert.equal(response.status, 204);
+  assert.equal(outgoing.headers.get("authorization"), `Bearer ${FAKE_SECRET}`);
+  assert.notEqual(outgoing.headers.get("authorization"), "Bearer container-chos
en-authority");
+});
+
+test("A3: the fake capability is observable only in the outgoing header", async
 () => {
+  const captured = [];
+  const original = {};
+  for (const method of ["log", "info", "warn", "error"]) {
+    original[method] = console[method];
+    console[method] = (...values) => captured.push(values.join(" "));
+  }
+
+  let positiveControl = "";
+  try {
+    const success = createStorageInternal(async (request) => {
+      positiveControl = request.headers.get("authorization") ?? "";
+      return new Response("store accepted request", { status: 200 });
+    });
+    const successResponse = await success(post("http://storage.internal/frontie
r"), ENV, {});
+
+    const failure = createStorageInternal(async () => {
+      throw new Error(`transport detail must be suppressed: ${FAKE_SECRET}`);
+    });
+    const failureResponse = await failure(post("http://storage.internal/frontie
r"), ENV, {});
+
+    const visible = [
+      ...captured,
+      await successResponse.text(),
+      await failureResponse.text(),
+    ].join("\n");
+
+    assert.match(positiveControl, new RegExp(FAKE_SECRET));
+    assert.doesNotMatch(visible, new RegExp(FAKE_SECRET));
+    assert.equal(failureResponse.status, 502);
+  } finally {
+    for (const method of ["log", "info", "warn", "error"]) console[method] = or
iginal[method];
+  }
+});
+
+test("A4: path and query are unchanged for every realm route", async () => {
+  const routes = [
+    "/create-log",
+    "/take-lease",
+    "/read-set",
+    "/commit",
+    "/frontier",
+    "/read-writer",
+    "/tail-local",
+  ];
+  const seen = [];
+  const handler = createStorageInternal(async (request) => {
+    const url = new URL(request.url);
+    seen.push(url.pathname + url.search);
+    return new Response(null, { status: 204 });
+  });
+
+  for (const [index, route] of routes.entries()) {
+    const suffix = `${route}?arm=A4&route=${index}`;
+    assert.equal((await handler(post(`http://storage.internal${suffix}`), ENV,
{})).status, 204);
+    assert.equal(seen.at(-1), suffix);
+  }
+  assert.deepEqual(seen, routes.map((route, index) => `${route}?arm=A4&route=${
index}`));
+});
+
+test("deployment config keeps the container offline and rooted at the repositor
y Dockerfile", async () => {
+  const config = JSON.parse(await readFile(new URL("../wrangler.jsonc", import.
meta.url), "utf8"));
+  const [container] = config.containers;
+  assert.equal(container.class_name, "CommonplaceNextContainer");
+  assert.equal(container.image, "../Dockerfile");
+  assert.equal(container.image_build_context, "..");
+
+  const source = await readFile(new URL("../src/index.js", import.meta.url), "u
tf8");
+  assert.match(source, /defaultPort = 4000/);
+  assert.match(source, /sleepAfter = "10m"/);
+  assert.match(source, /enableInternet = false/);
+  assert.match(source, /CommonplaceNextContainer\.outboundByHost/);
+  assert.match(source, /export \{ ContainerProxy \}/);
+  assert.doesNotMatch(source, /COMMONPLACE_SIDECAR_URL/);
+  assert.doesNotMatch(source, /COMMONPLACE_LOG_REALM_CAPABILITY:\s*this\.env/);
+});
