@@ -0,0 +1,133 @@
+#!/usr/bin/env bash
+# Self-test for dispatch-round prompt provenance. Fixtures are disposable local
 repositories;
+# this script never dispatches a real round and never contacts a network remote
.
+set -uo pipefail
+
+ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
+SCRIPT="$ROOT/bin/dispatch-round.sh"
+for need in bash git mktemp realpath; do
+  command -v "$need" >/dev/null 2>&1 || { echo "BLIND: required command is unav
ailable: $need" >&2; exit 2; }
+done
+[ -r "$SCRIPT" ] || { echo "BLIND: dispatch script is not readable: $SCRIPT" >&
2; exit 2; }
+
+T=$(mktemp -d) || { echo "BLIND: could not create fixture directory" >&2; exit
2; }
+trap 'rm -rf -- "$T" || true' EXIT
+mkdir -p "$T/fakebin" || { echo "BLIND: could not create fixture tools" >&2; ex
it 2; }
+printf '%s\n' '#!/usr/bin/env bash' 'case "${1:-}" in deps.get) mkdir -p deps/f
ake; : > deps/fake/fixture ;; compile) : ;; esac' > "$T/fakebin/mix"
+printf '%s\n' '#!/usr/bin/env bash' ': > "${DISPATCH_TEST_TMUX_MARKER:?}"' > "$
T/fakebin/tmux"
+printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$T/fakebin/sleep"
+chmod +x "$T/fakebin/mix" "$T/fakebin/tmux" "$T/fakebin/sleep"
+
+NAME="PROMPT-IN-TREE-1"
+REL="docs/plans/sol/prompt-in-tree-1/prompt.txt"
+make_prompt() {
+  local path=$1
+  mkdir -p "$(dirname "$path")"
+  {
+    printf '%s\n' "$NAME"
+    for n in $(seq 1 110); do printf 'fixture%s ' "$n"; done
+    printf '\n'
+  } > "$path"
+}
+make_fixture() {
+  local label=$1 round="$T/$1" wt="$T/$1/wt" bare="$T/$1-origin.git"
+  mkdir -p "$round"
+  git init -q --bare "$bare" || return 1
+  git init -q "$wt" || return 1
+  git -C "$wt" config user.email fixture@example.invalid || return 1
+  git -C "$wt" config user.name Fixture || return 1
+  printf 'fixture\n' > "$wt/README"
+  git -C "$wt" add README || return 1
+  git -C "$wt" commit -qm base || return 1
+  git -C "$wt" remote add origin "$bare" || return 1
+  git -C "$wt" push -qu origin HEAD || return 1
+}
+commit_prompt() {
+  local wt=$1
+  make_prompt "$wt/$REL"
+  git -C "$wt" add "$REL" || return 1
+  git -C "$wt" commit -qm prompt || return 1
+  git -C "$wt" push -q origin HEAD || return 1
+}
+run_dispatch() {
+  local marker=$1; shift
+  rm -f -- "$marker"
+  OUT=$(PATH="$T/fakebin:$PATH" DISPATCH_TEST_TMUX_MARKER="$marker" bash "$SCRI
PT" "$@" 2>&1)
+  RC=$?
+}
+setup_or_blind() {
+  "$@" || { echo "BLIND: fixture setup failed while running: $*" >&2; exit 2; }
+}
+fail_arm() {
+  local arm=$1 detail=$2
+  echo "$arm FAIL: $detail" >&2
+  printf '%s\n' "$OUT" >&2
+  failures=$((failures+1))
+}
+
+failures=0
+
+setup_or_blind make_fixture p1
+make_prompt "$T/p1/wt/$REL"
+run_dispatch "$T/p1.tmux" "$T/p1" "$NAME" --preflight
+p1_a=$(printf '%s\n' "$OUT" | grep -cF 'not tracked by git in the worktree (a)'
 || true)
+if [ "$RC" -eq 69 ] && [ "$p1_a" -eq 1 ]; then
+  echo "P1 PASS: untracked default brief refused with rc 69 and named (a)."
+else
+  fail_arm P1 "expected rc=69 and one (a) refusal; got rc=$RC count=$p1_a"
+fi
+
+setup_or_blind make_fixture p2
+setup_or_blind commit_prompt "$T/p2/wt"
+printf 'modified\n' >> "$T/p2/wt/$REL"
+run_dispatch "$T/p2.tmux" "$T/p2" "$NAME" --preflight
+p2_b=$(printf '%s\n' "$OUT" | grep -cF 'tracked but modified relative to HEAD (
b)' || true)
+if [ "$RC" -eq 69 ] && [ "$p2_b" -eq 1 ]; then
+  echo "P2 PASS: modified tracked brief refused with rc 69 and named (b)."
+else
+  fail_arm P2 "expected rc=69 and one (b) refusal; got rc=$RC count=$p2_b"
+fi
+
+setup_or_blind make_fixture p3
+setup_or_blind commit_prompt "$T/p3/wt"
+expected=$(git -C "$T/p3/wt" rev-parse "HEAD:$REL") || { echo "BLIND: could not
 compute P3 blob" >&2; exit 2; }
+run_dispatch "$T/p3.tmux" "$T/p3" "$NAME" --preflight
+p3_ok=$(printf '%s\n' "$OUT" | grep -cF "PREFLIGHT OK:" || true)
+p3_blob=$(printf '%s\n' "$OUT" | grep -cF "blob=$expected" || true)
+p3_path=$(printf '%s\n' "$OUT" | grep -cF "prompt=$T/p3/wt/$REL" || true)
+if [ "$RC" -eq 0 ] && [ "$p3_ok" -eq 1 ] && [ "$p3_blob" -eq 1 ] && [ "$p3_path
" -eq 1 ]; then
+  echo "P3 PASS: committed default brief preflight printed independently comput
ed blob $expected."
+else
+  fail_arm P3 "expected rc=0 with path and blob; got rc=$RC ok=$p3_ok path=$p3_
path blob=$p3_blob"
+fi
+
+setup_or_blind make_fixture p4
+setup_or_blind commit_prompt "$T/p4/wt"
+make_prompt "$T/p4/outside.txt"
+run_dispatch "$T/p4.tmux" "$T/p4" "$NAME" --prompt ../outside.txt
+p4_escape=$(printf '%s\n' "$OUT" | grep -cF 'path escapes the worktree' || true
)
+p4_dispatch=$(printf '%s\n' "$OUT" | grep -c '^DISPATCHED ' || true)
+if [ "$RC" -ne 0 ] && [ "$p4_escape" -eq 1 ] && [ "$p4_dispatch" -eq 0 ] && [ !
 -e "$T/p4.tmux" ]; then
+  echo "P4 PASS: escaping --prompt path refused without dispatch."
+else
+  fail_arm P4 "expected refusal and no tmux call; got rc=$RC escape=$p4_escape
dispatched=$p4_dispatch tmux=$([ -e "$T/p4.tmux" ] && echo yes || echo no)"
+fi
+
+setup_or_blind make_fixture p5
+make_prompt "$T/p5/prompt.txt"
+run_dispatch "$T/p5.tmux" "$T/p5" "$NAME" --prompt-out-of-tree --preflight
+p5_ok=$(printf '%s\n' "$OUT" | grep -cF 'PREFLIGHT OK:' || true)
+p5_warning=$(printf '%s\n' "$OUT" | grep -cF "WARNING: round '$NAME' uses an ou
t-of-tree brief; the brief will not be readable from the remote." || true)
+p5_blob=$(printf '%s\n' "$OUT" | grep -cF 'blob=none (out of tree)' || true)
+if [ "$RC" -eq 0 ] && [ "$p5_ok" -eq 1 ] && [ "$p5_warning" -eq 1 ] && [ "$p5_b
lob" -eq 1 ]; then
+  echo "P5 PASS: legacy out-of-tree brief preflight succeeded and printed the r
emote-readability warning."
+else
+  fail_arm P5 "expected rc=0 with warning and out-of-tree blob; got rc=$RC ok=$
p5_ok warning=$p5_warning blob=$p5_blob"
+fi
+
+if [ "$failures" -gt 0 ]; then
+  echo "SELF-TEST FAIL: $failures arm(s) failed." >&2
+  exit 1
+fi
+echo "SELF-TEST PASS: P1 P2 P3 P4 P5 all passed."
+exit 0

exec
/bin/bash -lc 'bash bin/test-dispatch-prompt.sh' in /home/jes/sol-cell-prompt-in
-tree/wt
 succeeded in 729ms:
P1 PASS: untracked default brief refused with rc 69 and named (a).
P2 PASS: modified tracked brief refused with rc 69 and named (b).
P3 PASS: committed default brief preflight printed independently computed blob 6
31bc8705400f2efd9ad3afb833f72b4a003fa58.
P4 PASS: escaping --prompt path refused without dispatch.
P5 PASS: legacy out-of-tree brief preflight succeeded and printed the remote-rea
dability warning.
SELF-TEST PASS: P1 P2 P3 P4 P5 all passed.

