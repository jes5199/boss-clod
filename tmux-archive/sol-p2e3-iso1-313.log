ce and mints bound to the root
  # directory -- the same ground the local resolve presents, so
both lanes are admitted by the same
  # evidence rather than by two different kinds of it.
  defp document_grant_leg(options, %Address{resource: {:path, _p
ath}}, verb) do
    grant_leg(options, verb == "directory.resolve")
  end

  defp document_grant_leg(options, _target, _verb), do: options

