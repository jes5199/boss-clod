defmodule CommonplaceNext.Realm.Route do
  @moduledoc "Routes Cell requests according to the current BEAM
's placement."

  @behaviour Commonplace.Cell.Router

  alias Commonplace.Cell.{Address, Error}
  alias CommonplaceNext.Realm.{Gateway, Placement, Router}
  alias CommonplaceNext.{EditorCell, WorkspaceCell}

  @impl true
  def request(source_cell_id, target, verb, arguments, options)
