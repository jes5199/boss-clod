+#!/usr/bin/env bash
+# Self-test for assert-diff. Every fixture lives in a disposable LOCAL git
+# repository; this script never reads test history from this repository and
+# never contacts a network remote.
+set -uo pipefail
+
+ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
+SCRIPT="$ROOT/bin/assert-diff.sh"
+[ -r "$SCRIPT" ] || { echo "BLIND: assert-diff script is not readable: $SCRIPT"
 >&2; exit 2; }
+
+T=$(mktemp -d) || { echo "BLIND: could not create fixture directory." >&2; exit
 2; }
+trap 'rm -rf -- "$T" || true' EXIT
+repo="$T/repo"
+mkdir -p "$repo/test" || { echo "BLIND: could not create fixture tree." >&2; ex
it 2; }
+git init -q "$repo" || { echo "BLIND: could not initialize fixture repository."
 >&2; exit 2; }
+git -C "$repo" config user.email fixture@example.invalid || exit 2
+git -C "$repo" config user.name Fixture || exit 2
+
+printf '%s\n' '  assert old_value == 1' > "$repo/test/a1.exs"
+printf '%s\n' '  refute deleted_value' > "$repo/test/a2.exs"
+printf '%s\n' '  value = 3' > "$repo/test/a3.exs"
+printf '%s\n' '  assert removable == true' > "$repo/test/a4.exs"
+printf '%s\n' '  assert moved_value == 5' '  value = 5' > "$repo/test/a5.exs"
+git -C "$repo" add test || exit 2
+git -C "$repo" commit -qm base || exit 2
+base=$(git -C "$repo" rev-parse HEAD) || exit 2
+
+printf '%s\n' '  assert new_value == 2' > "$repo/test/a1.exs"
+: > "$repo/test/a2.exs"
+printf '%s\n' '  value = 3' '  assert added_value == 3' > "$repo/test/a3.exs"
+: > "$repo/test/a4.exs"
+printf '%s\n' '  value = 5' '' '' '      assert   moved_value   ==   5' > "$rep
o/test/a5.exs"
+git -C "$repo" add test || exit 2
+git -C "$repo" commit -qm head || exit 2
+head=$(git -C "$repo" rev-parse HEAD) || exit 2
+printf '%s\n' 'assert removable == true' > "$T/declared"
+
+failures=0
+OUT=""
+RC=0
+run_tool() {
+  OUT=$(cd "$repo" && bash "$SCRIPT" "$@" 2>&1)
+  RC=$?
+}
+fail_arm() {
+  local arm=$1 detail=$2
+  echo "$arm FAIL: $detail" >&2
+  printf '%s\n' "$OUT" >&2
+  failures=$((failures + 1))
+}
+
+run_tool "$base" "$head" -- test/a1.exs
+if [ "$RC" -eq 1 ] &&
+   grep -Fq 'CHANGED (undeclared) BASE test/a1.exs: assert old_value == 1' <<<
"$OUT" &&
+   grep -Fq 'CHANGED HEAD test/a1.exs: assert new_value == 2' <<< "$OUT"; then
+  echo "A1 PASS: changed assertion refused with rc 1 and named both texts."
+else
+  fail_arm A1 "expected rc=1 and both changed texts; got rc=$RC"
+fi
+
+run_tool "$base" "$head" -- test/a2.exs
+if [ "$RC" -eq 1 ] && grep -Fq 'REMOVED (undeclared) test/a2.exs: refute delete
d_value' <<< "$OUT"; then
+  echo "A2 PASS: deleted assertion refused with rc 1 and named its text."
+else
+  fail_arm A2 "expected rc=1 and the removed text; got rc=$RC"
+fi
+
+run_tool "$base" "$head" -- test/a3.exs
+if [ "$RC" -eq 0 ] && grep -Fq 'ADDED test/a3.exs: assert added_value == 3' <<<
 "$OUT"; then
+  echo "A3 PASS: added-only assertion printed and remained green with rc 0."
+else
+  fail_arm A3 "expected rc=0 and the added text; got rc=$RC"
+fi
+
+run_tool "$base" "$head" --declared "$T/declared" -- test/a4.exs
+if [ "$RC" -eq 0 ] && grep -Fq 'REMOVED (declared) test/a4.exs: assert removabl
e == true' <<< "$OUT"; then
+  echo "A4 PASS: declared removal remained printed and returned rc 0."
+else
+  fail_arm A4 "expected rc=0 and a printed declared removal; got rc=$RC"
+fi
+
+run_tool "$base" "$head" -- test/a5.exs
+if [ "$RC" -eq 0 ] &&
+   ! grep -Eq '^(REMOVED|CHANGED)' <<< "$OUT"; then
+  echo "A5 PASS: moved, whitespace-normalized assertion produced no false red a
nd returned rc 0."
+else
+  fail_arm A5 "expected rc=0 with no REMOVED or CHANGED item; got rc=$RC"
+fi
+
+run_tool does-not-resolve "$head" -- test/a1.exs
+if [ "$RC" -eq 2 ] && grep -Fq 'BLIND: base sha does not resolve to a commit: d
oes-not-resolve' <<< "$OUT"; then
+  echo "A6 PASS: unresolved sha returned BLIND rc 2."
+else
+  fail_arm A6 "expected BLIND rc=2; got rc=$RC"
+fi
+
+if [ "$failures" -gt 0 ]; then
+  echo "SELF-TEST FAIL: $failures arm(s) failed." >&2
+  exit 1
+fi
+echo "SELF-TEST PASS: A1 A2 A3 A4 A5 A6 all passed."
+exit 0

