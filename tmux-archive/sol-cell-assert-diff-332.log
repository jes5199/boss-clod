## `bin/assert-diff.sh` in full

```bash
#!/usr/bin/env bash
# Gate assertion text, not line positions, between two commits.
#
# WHY THIS EXISTS. Measured in this fleet on 2026-09-04: two arms were re-pointe
d
# from one refusal code to another, and a cosmetic realignment nearly broke a
# landed assertion about DDL spacing. Both looked like ordinary changes in a
# 39-file diff. This makes removed and rewritten expectations mechanical to see.
#
# This check CANNOT decide whether an intentional expectation change is correct.
# A declaration only records that intent and permits the change; it never hides
# it. Added assertions are also evidence, but do not justify refusing a round.
#
# rc 0 = allowed · rc 1 = REFUSED (undeclared removal/change)
# rc 2 = BLIND (the requested comparison could not be made)
set -uo pipefail

usage() {
  echo "BLIND: usage: $(basename "$0") <base-sha> <head-sha> [--declared <file>]
 -- <test path>..." >&2
  exit 2
}

[ "$#" -ge 2 ] || usage
base=$1
head=$2
shift 2
declared=""

while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
  case "$1" in
    --declared)
      [ "$#" -ge 2 ] || usage
      [ -z "$declared" ] || usage
      declared=$2
      shift 2
      ;;
    *) usage ;;
  esac
done
[ "$#" -gt 0 ] && [ "$1" = "--" ] || usage
shift
[ "$#" -gt 0 ] || { echo "BLIND: no test paths were given after --." >&2; exit 2
; }

git rev-parse --verify --quiet "${base}^{commit}" >/dev/null || {
  echo "BLIND: base sha does not resolve to a commit: $base" >&2
  exit 2
}
git rev-parse --verify --quiet "${head}^{commit}" >/dev/null || {
  echo "BLIND: head sha does not resolve to a commit: $head" >&2
  exit 2
}

if [ -n "$declared" ] && [ ! -r "$declared" ]; then
  echo "BLIND: declared assertion file is not readable: $declared" >&2
  exit 2
fi

tmp=$(mktemp -d) || { echo "BLIND: could not create working directory." >&2; exi
t 2; }
trap 'rm -rf -- "$tmp" || true' EXIT
declarations="$tmp/declarations"
if [ -n "$declared" ]; then
  awk '!/^#/ && !/^[[:space:]]*$/' "$declared" > "$declarations"
else
  : > "$declarations"
fi

extract_assertions() {
  awk '
    /^[[:space:]]*(assert|assert_raise|assert_receive|refute|refute_receive|flun
k)([[:space:](]|$)/ {
      sub(/^[[:space:]]+/, "")
      sub(/[[:space:]]+$/, "")
      gsub(/[[:space:]]+/, " ")
      print
    }
  '
}

is_declared() {
  grep -Fxq -- "$1" "$declarations"
}

refused=0
path_number=0
for path in "$@"; do
  path_number=$((path_number + 1))
  base_present=0
  head_present=0
  base_type=$(git cat-file -t "${base}:${path}" 2>/dev/null) && base_present=1
  head_type=$(git cat-file -t "${head}:${path}" 2>/dev/null) && head_present=1

  if [ "$base_present" -eq 0 ] && [ "$head_present" -eq 0 ]; then
    echo "BLIND: path is absent at both shas: $path" >&2
    exit 2
  fi
  if { [ "$base_present" -eq 1 ] && [ "$base_type" != "blob" ]; } ||
     { [ "$head_present" -eq 1 ] && [ "$head_type" != "blob" ]; }; then
    echo "BLIND: path does not name a file blob at every sha where it is present
: $path" >&2
    exit 2
  fi

  base_lines="$tmp/base.$path_number"
  head_lines="$tmp/head.$path_number"
  base_only="$tmp/base-only.$path_number"
  head_only="$tmp/head-only.$path_number"
  base_raw="$tmp/base-raw.$path_number"
  head_raw="$tmp/head-raw.$path_number"
  if [ "$base_present" -eq 1 ]; then
    git show "${base}:${path}" > "$base_raw" || {
      echo "BLIND: could not read $path at base sha $base" >&2
      exit 2
    }
    extract_assertions < "$base_raw" | sort > "$base_lines"
  fi
  if [ "$head_present" -eq 1 ]; then
    git show "${head}:${path}" > "$head_raw" || {
      echo "BLIND: could not read $path at head sha $head" >&2
      exit 2
    }
    extract_assertions < "$head_raw" | sort > "$head_lines"
  fi
  [ -e "$base_lines" ] || : > "$base_lines"
  [ -e "$head_lines" ] || : > "$head_lines"

  # comm preserves duplicate lines, so cancellation here is multiset subtraction
.
  comm -23 "$base_lines" "$head_lines" > "$base_only"
  comm -13 "$base_lines" "$head_lines" > "$head_only"

  exec 3< "$base_only"
  exec 4< "$head_only"
  while :; do
    old=""
    new=""
    IFS= read -r old <&3 || true
    IFS= read -r new <&4 || true
    [ -n "$old" ] || [ -n "$new" ] || break

    if [ -n "$old" ] && [ -n "$new" ]; then
      if is_declared "$old"; then
        echo "CHANGED (declared) BASE $path: $old"
      else
        echo "CHANGED (undeclared) BASE $path: $old"
        refused=1
      fi
      echo "CHANGED HEAD $path: $new"
    elif [ -n "$old" ]; then
      if is_declared "$old"; then
        echo "REMOVED (declared) $path: $old"
      else
        echo "REMOVED (undeclared) $path: $old"
        refused=1
      fi
    else
      echo "ADDED $path: $new"
    fi
  done
  exec 3<&-
  exec 4<&-
done

if [ "$refused" -eq 1 ]; then
  echo "VERDICT: REFUSED -- at least one removed or changed base assertion is un
declared."
  exit 1
fi
echo "VERDICT: PASS -- no removed or changed base assertion is undeclared."
exit 0
