fi

run_tool "$base" "$head" -- test/a2.exs
if [ "$RC" -eq 1 ] && grep -Fq 'REMOVED (undeclared) test/a2.exs: refute deleted
_value' <<< "$OUT"; then
  echo "A2 PASS: deleted assertion refused with rc 1 and named its text."
else
  fail_arm A2 "expected rc=1 and the removed text; got rc=$RC"
fi

run_tool "$base" "$head" -- test/a3.exs
if [ "$RC" -eq 0 ] && grep -Fq 'ADDED test/a3.exs: assert added_value == 3' <<<
"$OUT"; then
  echo "A3 PASS: added-only assertion printed and remained green with rc 0."
else
  fail_arm A3 "expected rc=0 and the added text; got rc=$RC"
fi

run_tool "$base" "$head" --declared "$T/declared" -- test/a4.exs
if [ "$RC" -eq 0 ] && grep -Fq 'REMOVED (declared) test/a4.exs: assert removable
 == true' <<< "$OUT"; then
  echo "A4 PASS: declared removal remained printed and returned rc 0."
else
  fail_arm A4 "expected rc=0 and a printed declared removal; got rc=$RC"
fi

run_tool "$base" "$head" -- test/a5.exs
if [ "$RC" -eq 0 ] &&
   ! grep -Eq '^(REMOVED|CHANGED)' <<< "$OUT"; then
  echo "A5 PASS: moved, whitespace-normalized assertion produced no false red an
d returned rc 0."
else
  fail_arm A5 "expected rc=0 with no REMOVED or CHANGED item; got rc=$RC"
fi

run_tool does-not-resolve "$head" -- test/a1.exs
if [ "$RC" -eq 2 ] && grep -Fq 'BLIND: base sha does not resolve to a commit: do
es-not-resolve' <<< "$OUT"; then
