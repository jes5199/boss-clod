+++ b/test/commonplace_next/web/work_os_controller_test.exs
@@ -0,0 +1,44 @@
+defmodule CommonplaceNext.Web.WorkOSControllerTest do
+  use ExUnit.Case, async: false
+
+  alias CommonplaceNext.WorkOS.Login
+
+  setup do
+    previous = Application.get_env(:commonplace_next, Login)
+    Application.delete_env(:commonplace_next, Login)
+
+    on_exit(fn ->
+      if previous,
+        do: Application.put_env(:commonplace_next, Login, previous),
+        else: Application.delete_env(:commonplace_next, Login)
+    end)
+
+    :ok
+  end
+
+  test "a callback state mismatch returns 401 and establishes no login session"
 do
+    Application.put_env(:commonplace_next, Login,
+      client_id: "client-test",
+      api_key: "secret-test",
+      issuer: "https://api.workos.com/",
+      redirect_uri: "https://app.example.test/auth/workos/callback"
+    )
+
+    conn =
+      Plug.Test.conn(:get, "/auth/workos/callback?state=wrong&code=code-1")
+      |> Plug.Test.init_test_session(%{workos_state: "expected", login: nil})
+      |> route()
+
+    assert conn.status == 401
+    assert conn.resp_body == "state_mismatch"
+    assert Plug.Conn.get_session(conn, :login) == nil
+  end
+
+  test "an unconfigured WorkOS login route returns named not configured 404" do
+    conn = Plug.Test.conn(:get, "/auth/workos") |> Plug.Test.init_test_session(
%{}) |> route()
+    assert conn.status == 404
+    assert conn.resp_body == "not_configured"
+  end
+
+  defp route(conn), do: CommonplaceNext.Web.Router.call(conn, CommonplaceNext.W
eb.Router.init([]))
+end
