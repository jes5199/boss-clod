+defmodule CommonplaceNext.WorkOS.LoginTest do
+  use ExUnit.Case, async: false
+
+  alias CommonplaceNext.CloudflareAccess.{AssertionVerifier, AuthenticatedHuman
}
+  alias CommonplaceNext.Test.WorkOSTransport
+  alias CommonplaceNext.WorkOS.Login
+
+  @issuer "https://api.workos.com/"
+  @config [
+    client_id: "client-test",
+    api_key: "secret-test",
+    redirect_uri: "https://app.example.test/auth/workos/callback",
+    issuer: @issuer
+  ]
+
+  setup do
+    previous = Application.get_env(:commonplace_next, Login)
+    Application.put_env(:commonplace_next, Login, @config)
+
+    on_exit(fn ->
+      if previous,
+        do: Application.put_env(:commonplace_next, Login, previous),
+        else: Application.delete_env(:commonplace_next, Login)
+    end)
+
+    private_key = JOSE.JWK.generate_key({:rsa, 2_048})
+    public_key = public_key(private_key, "test-1")
+    {:ok, private_key: private_key, public_key: public_key}
+  end
+
+  test "code exchange records one form POST and its token verifies as a WorkOS
human", ctx do
+    token = token(ctx.private_key, "test-1")
+
+    response =
+      Jason.encode!(%{
+        "access_token" => token,
+        "user" => %{"email" => " Person@Example.Test "}
+      })
+
+    {:ok, fake} = WorkOSTransport.start_link({:ok, 200, [], response})
+
+    assert {:ok, exchange} = Login.exchange("code-1", WorkOSTransport.transport
(fake))
+
+    assert [{:post, url, headers, body}] = WorkOSTransport.requests(fake)
+    assert url == "https://api.workos.com/user_management/authenticate"
+    assert {"content-type", "application/x-www-form-urlencoded"} in headers
+
+    form = URI.decode_query(body)
+    assert form["grant_type"] == "authorization_code"
+    assert form["code"] == "code-1"
+    assert form["client_id"] == "client-test"
+    assert form["client_secret"] == "secret-test"
+
+    assert {:ok,
+            %AuthenticatedHuman{
+              provider: :workos,
+              subject: "user_01TEST",
+              email: "person@example.test",
+              audience: nil
+            }} = Login.verify(exchange, fn "test-1" -> {:ok, ctx.public_key} en
d, @issuer)
+  end
+
+  test "a token signed by a kid absent from the fixture JWKS is unknown", ctx d
o
+    token = token(ctx.private_key, "absent")
+
+    assert {:error, :unknown_kid} =
+             Login.verify(token, fn _ -> {:error, :unknown_kid} end, @issuer)
+  end
+
+  test "a WorkOS token with a different issuer is refused", ctx do
+    token = token(ctx.private_key, "test-1", %{"iss" => "https://issuer.example
.test/"})
+
+    assert {:error, :issuer_mismatch} =
+             Login.verify(token, fn _ -> {:ok, ctx.public_key} end, @issuer)
+  end
+
+  test "an expired WorkOS token is refused", ctx do
+    now = System.system_time(:second)
+    token = token(ctx.private_key, "test-1", %{"iat" => now - 100, "exp" => now
 - 1})
+    assert {:error, :expired} = Login.verify(token, fn _ -> {:ok, ctx.public_ke
y} end, @issuer)
+  end
+
+  test "the default Access profile still refuses a token missing audience", ctx
 do
+    token =
+      token(ctx.private_key, "test-1", %{
+        "type" => "app",
+        "nbf" => System.system_time(:second) - 1
+      })
+
+    assert {:error, :audience_mismatch} =
+             AssertionVerifier.verify(token, fn _ -> {:ok, ctx.public_key} end,
+               issuer: @issuer,
+               audience: "access-audience",
+               max_lifetime_seconds: 3_600,
+               now: System.system_time(:second)
+             )
+  end
+
+  test "production configuration raises naming WORKOS_API_KEY when it is absent
" do
+    names = ~w(WORKOS_CLIENT_ID WORKOS_API_KEY WORKOS_REDIRECT_URI WORKOS_ISSUE
R)
+    previous = Map.new(names, &{&1, System.get_env(&1)})
+
+    on_exit(fn -> Enum.each(previous, fn {name, value} -> restore_env(name, val
ue) end) end)
+
+    System.put_env("WORKOS_CLIENT_ID", "client-test")
+    System.delete_env("WORKOS_API_KEY")
+    System.put_env("WORKOS_REDIRECT_URI", "https://app.example.test/auth/workos
/callback")
+
+    error = assert_raise ArgumentError, &Login.production_config!/0
+    assert Exception.message(error) =~ "WORKOS_API_KEY"
+  end
+
+  defp token(private_key, kid, changes \\ %{}) do
+    now = System.system_time(:second)
+
+    claims =
+      Map.merge(
+        %{"iss" => @issuer, "sub" => "user_01TEST", "iat" => now - 10, "exp" =>
 now + 600},
+        changes
+      )
+
+    private_key
+    |> JOSE.JWT.sign(%{"alg" => "RS256", "kid" => kid, "typ" => "JWT"}, claims)
+    |> JOSE.JWS.compact()
+    |> elem(1)
+  end
+
+  defp public_key(private_key, kid) do
+    {_type, map} = private_key |> JOSE.JWK.to_public() |> JOSE.JWK.to_map()
+    JOSE.JWK.from_map(Map.merge(map, %{"kid" => kid, "alg" => "RS256", "use" =>
 "sig"}))
+  end
+
+  defp restore_env(name, nil), do: System.delete_env(name)
+  defp restore_env(name, value), do: System.put_env(name, value)
+end
