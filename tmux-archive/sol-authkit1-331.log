diff --git a/lib/commonplace_next/web/work_os_controller.ex b/lib/commonplace_ne
xt/web/work_os_controller.ex
new file mode 100644
index 0000000000000000000000000000000000000000..ddb78dcba6a190ff47c3449d6cc02e6f
86df7e82
--- /dev/null
+++ b/lib/commonplace_next/web/work_os_controller.ex
@@ -0,0 +1,70 @@
+defmodule CommonplaceNext.Web.WorkOSController do
+  @moduledoc "The two browser endpoints of the hosted WorkOS AuthKit flow."
+
+  import Plug.Conn
+
+  alias CommonplaceNext.CloudflareAccess.AuthenticatedHuman
+  alias CommonplaceNext.Web.Session
+  alias CommonplaceNext.WorkOS.{KeySource, Login}
+
+  @state_session_key :workos_state
+  @nonce_session_key :workos_nonce
+
+  def init(action), do: action
+  def call(conn, action), do: apply(__MODULE__, action, [conn, conn.params])
+
+  def login(conn, _params) do
+    if Login.configured?() do
+      state = random_value()
+      nonce = random_value()
+
+      conn
+      |> put_session(@state_session_key, state)
+      |> put_session(@nonce_session_key, nonce)
+      |> put_resp_header("location", Login.authorize_url(state, nonce))
+      |> send_resp(302, "")
+    else
+      refuse(conn, 404, :not_configured)
+    end
+  end
+
+  def callback(conn, params) do
+    if Login.configured?() do
+      configured_callback(conn, params)
+    else
+      refuse(conn, 404, :not_configured)
+    end
+  end
+
+  defp configured_callback(conn, params) do
+    expected_state = get_session(conn, @state_session_key)
+
+    conn =
+      conn
+      |> delete_session(@state_session_key)
+      |> delete_session(@nonce_session_key)
+
+    with :ok <- matching_state(expected_state, Map.get(params, "state")),
+         {:ok, exchange} <- Login.exchange(Map.get(params, "code")),
+         {:ok, %AuthenticatedHuman{} = human} <-
+           Login.verify(exchange, KeySource.resolver(), Login.issuer()) do
+      conn
+      |> Session.establish(human)
+      |> put_resp_header("location", "/")
+      |> send_resp(302, "")
+    else
+      {:error, reason} -> refuse(conn, 401, reason)
+      _ -> refuse(conn, 401, :invalid_token)
+    end
+  end
+
+  defp matching_state(expected, actual)
+       when is_binary(expected) and expected != "" and expected == actual,
+       do: :ok
+
+  defp matching_state(_expected, _actual), do: {:error, :state_mismatch}
+
+  defp random_value, do: 32 |> :crypto.strong_rand_bytes() |> Base.url_encode64
(padding: false)
+
+  defp refuse(conn, status, reason), do: send_resp(conn, status, Atom.to_string
(reason))
+end
diff --git a/lib/commonplace_next/work_os/key_source.ex b/lib/commonplace_next/w
ork_os/key_source.ex
new file mode 100644
index 0000000000000000000000000000000000000000..9860696b613bd56a93cda80a88520e33
be47963d
--- /dev/null
+++ b/lib/commonplace_next/work_os/key_source.ex
@@ -0,0 +1,23 @@
+defmodule CommonplaceNext.WorkOS.KeySource do
+  @moduledoc "The WorkOS-named instance of the shared kid-indexed JWKS cache."
+
+  alias CommonplaceNext.CloudflareAccess.KeySource, as: SharedKeySource
+
+  @name __MODULE__
+
+  def child_spec(options) do
+    %{id: __MODULE__, start: {SharedKeySource, :start_link, [Keyword.put(option
s, :name, @name)]}}
+  end
+
+  def configured? do
+    case Keyword.get(configuration(), :jwks_uri) do
+      uri when is_binary(uri) and uri != "" -> true
+      _ -> false
+    end
+  end
+
+  def resolver, do: SharedKeySource.resolver(@name)
+  def fetch_key(kid), do: SharedKeySource.fetch_key(kid, @name)
+
+  defp configuration, do: Application.get_env(:commonplace_next, __MODULE__, []
)
+end
diff --git a/lib/commonplace_next/work_os/login.ex b/lib/commonplace_next/work_o
s/login.ex
new file mode 100644
index 0000000000000000000000000000000000000000..0577315a2b0e6c3d03bbbf5653551061
a92eca3a
--- /dev/null
+++ b/lib/commonplace_next/work_os/login.ex
@@ -0,0 +1,175 @@
+defmodule CommonplaceNext.WorkOS.Login do
+  @moduledoc "Hosted AuthKit authorization, server-side code exchange, and toke
n verification."
+
+  alias CommonplaceNext.CloudflareAccess.{AssertionVerifier, AuthenticatedHuman
}
+
+  @authorize_url "https://api.workos.com/user_management/authorize"
+  @authenticate_url "https://api.workos.com/user_management/authenticate"
+  @default_issuer "https://api.workos.com/"
+  @max_lifetime_seconds 86_400
+
+  def configured? do
+    config = configuration()
+
+    Enum.all?([:client_id, :api_key, :issuer, :redirect_uri], fn key ->
+      value = Keyword.get(config, key)
+      is_binary(value) and value != ""
+    end)
+  end
+
+  def authorize_url(state, nonce) when is_binary(state) and is_binary(nonce) do
+    config = configuration()
+
+    query =
+      URI.encode_query(%{
+        "client_id" => Keyword.get(config, :client_id, ""),
+        "nonce" => nonce,
+        "provider" => "authkit",
+        "redirect_uri" => Keyword.get(config, :redirect_uri, ""),
+        "response_type" => "code",
+        "state" => state
+      })
+
+    @authorize_url <> "?" <> query
+  end
+
+  def exchange(code), do: exchange(code, configured_transport())
+
+  def exchange(code, transport)
+      when is_binary(code) and code != "" and is_function(transport, 4) do
+    config = configuration()
+
+    body =
+      URI.encode_query(%{
+        "client_id" => Keyword.get(config, :client_id, ""),
+        "client_secret" => Keyword.get(config, :api_key, ""),
+        "code" => code,
+        "grant_type" => "authorization_code"
+      })
+
+    headers = [{"content-type", "application/x-www-form-urlencoded"}]
+
+    with {:ok, status, _response_headers, response_body} <-
+           transport.(:post, @authenticate_url, headers, body),
+         true <- status in 200..299,
+         {:ok, response} <- Jason.decode(response_body),
+         access_token when is_binary(access_token) and access_token != "" <-
+           Map.get(response, "access_token"),
+         %{"email" => email} when is_binary(email) and email != "" <- Map.get(r
esponse, "user") do
+      {:ok, %{access_token: access_token, email: email}}
+    else
+      _ -> {:error, :exchange_failed}
+    end
+  rescue
+    _ -> {:error, :exchange_failed}
+  catch
+    _, _ -> {:error, :exchange_failed}
+  end
+
+  def exchange(_code, _transport), do: {:error, :exchange_failed}
+
+  def verify(%{access_token: access_token, email: email}, resolver, issuer) do
+    with {:ok, %AuthenticatedHuman{} = human} <- verify(access_token, resolver,
 issuer),
+         {:ok, normalized_email} <- normalize_email(email) do
+      {:ok, %{human | email: normalized_email}}
+    else
+      {:error, reason} -> {:error, reason}
+      _ -> {:error, :invalid_token}
+    end
+  end
+
+  def verify(access_token, resolver, issuer)
+      when is_binary(access_token) and is_function(resolver, 1) and is_binary(i
ssuer) do
+    # WorkOS access tokens have no aud claim. The explicit provider keeps that
omission confined
+    # to this profile; the default Cloudflare profile continues to require aud,
 type and nbf.
+    case AssertionVerifier.verify(access_token, resolver,
+           provider: :workos,
+           issuer: issuer,
+           max_lifetime_seconds: @max_lifetime_seconds,
+           now: System.system_time(:second)
+         ) do
+      {:ok, human} -> {:ok, human}
+      {:error, :key_resolution_failed} -> {:error, :unknown_kid}
+      {:error, :expired} -> {:error, :expired}
+      {:error, :issuer_mismatch} -> {:error, :issuer_mismatch}
+      {:error, _reason} -> {:error, :invalid_token}
+    end
+  end
+
+  def verify(_access_token, _resolver, _issuer), do: {:error, :invalid_token}
+
+  def issuer, do: Keyword.get(configuration(), :issuer)
+
+  def production_config! do
+    client_id = fetch_env!("WORKOS_CLIENT_ID")
+    api_key = fetch_env!("WORKOS_API_KEY")
+    redirect_uri = fetch_env!("WORKOS_REDIRECT_URI")
+    issuer = nonempty_env("WORKOS_ISSUER") || @default_issuer
+
+    [client_id: client_id, api_key: api_key, redirect_uri: redirect_uri, issuer
: issuer]
+  end
+
+  def httpc_transport(:post, url, headers, body) do
+    request = {
+      String.to_charlist(url),
+      Enum.map(headers, fn {key, value} ->
+        {String.to_charlist(key), String.to_charlist(value)}
+      end),
+      ~c"application/x-www-form-urlencoded",
+      body
+    }
+
+    http_options = [
+      timeout: 3_000,
+      connect_timeout: 2_000,
+      ssl: [
+        verify: :verify_peer,
+        cacerts: :public_key.cacerts_get(),
+        depth: 3,
+        customize_hostname_check: [
+          match_fun: :public_key.pkix_verify_hostname_match_fun(:https)
+        ]
+      ]
+    ]
+
+    case :httpc.request(:post, request, http_options,
+           body_format: :binary
+         ) do
+      {:ok, {{_version, status, _reason}, response_headers, response_body}} ->
+        {:ok, status, response_headers, response_body}
+
+      {:error, reason} ->
+        {:error, reason}
+    end
+  end
+
+  defp normalize_email(email) when is_binary(email) do
+    normalized = email |> String.trim() |> String.downcase()
+    if normalized != "" and byte_size(normalized) <= 320, do: {:ok, normalized}
, else: :error
+  end
+
+  defp normalize_email(_email), do: :error
+
+  defp configured_transport do
+    case Keyword.get(configuration(), :transport) do
+      transport when is_function(transport, 4) -> transport
+      _ -> &__MODULE__.httpc_transport/4
+    end
+  end
+
+  defp fetch_env!(name) do
+    case nonempty_env(name) do
+      value when is_binary(value) -> value
+      nil -> raise ArgumentError, "environment variable #{name} is required"
+    end
+  end
+
+  defp nonempty_env(name) do
+    case System.get_env(name) do
+      value when is_binary(value) and value != "" -> value
+      _ -> nil
+    end
+  end
+
+  defp configuration, do: Application.get_env(:commonplace_next, __MODULE__, []
)
+end
diff --git a/test/commonplace_next/web/work_os_controller_test.exs b/test/common
place_next/web/work_os_controller_test.exs
