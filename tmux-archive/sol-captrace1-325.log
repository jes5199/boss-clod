#!/usr/bin/env bash
# Run a command, keep ALL of its output in a file, print the summary line and th
e FILE'S PATH,
# and exit with THE COMMAND'S rc.
#
# Usage: bin/capture-run.sh [--overwrite] [--time] <label> <cmd> [args...]
#
# ⛔⛔ WHY THIS IS A SHARED SCRIPT AND NOT A RULE. Three runners in this reposit
ory have piped a
# suite through `tail`, and `[measured 2026-09-03]` that truncation cost the IDE
NTITY of a failure
# three times in one day -- once in `bump-pin.sh`, twice in ad-hoc runners writt
en the same hour by
# someone who had just filed the finding. ExUnit prints its FAILURE BLOCKS BEFOR
E the summary, so a
# tail keeps "N tests, K failures" and drops WHICH.
# ⭐ The correction already existed at `land-round.sh:38-42`, written 2026-08-25
 for this exact
# reason. It could not help the others because AN ARTIFACT ONLY FIRES WHERE IT I
S INSTALLED: a fix
# filed inside one runner does not reach the next runner anybody writes. One scr
ipt, called by all
# of them, is the only version of this that cannot drift per caller.
#
# ⛔ AND THE rc IS THE COMMAND'S. `cmd | tee log` exits with tee's status, and `
cmd | tail -1`
# exits with tail's -- both 0 whichever way the suite went. This runs the comman
d with its output
# REDIRECTED, never piped, so `$?` is the thing you asked about.
#
# ⛔⛔ AND THE LABEL IS A FILENAME, SO TWO RUNS UNDER ONE LABEL ARE ONE FILE. `[
measured 2026-09-04]`
# three runs sharing the label `org2b-fullsuite` left one log: the 539-tests/12-
failures run that
# was the whole reason to look was overwritten by the run that came after it, an
d the overwrite was
# SILENT. ⭐ That is this script's own subject aimed at itself -- it exists beca
use truncation
# destroys the identity of a failure, and it was destroying whole failures by a
different mechanism.
# ⇒ An existing log is REFUSED with rc 73 (EX_CANTCREAT) BEFORE the command runs
, so a refusal
# never costs the run it was protecting and never half-writes the file it was pr
otecting.
# ⭐ `--overwrite` is the explicit escape, because a caller with STABLE labels b
y design is not
# making this mistake; it must say so in argv rather than have the guard guess.
`bin/bump-pin.sh` is
# the one such caller in the tree (`[measured]` 1 of 1 in `bin/`, 0 in `test/`).
set -u

overwrite=0
timing=0
while :; do
  case "${1:-}" in
    --overwrite) overwrite=1; shift ;;
    --time)      timing=1;    shift ;;
    *) break ;;
  esac
done

label="${1:?usage: capture-run.sh [--overwrite] [--time] <label> <cmd> [args...]
}"; shift
[ "$#" -gt 0 ] || { echo "capture-run.sh: no command given" >&2; exit 64; }

dir="${CAPTURE_RUN_DIR:-tmp/run-logs}"
mkdir -p "$dir" || { echo "capture-run.sh: cannot create $dir" >&2; exit 64; }
log="$dir/$(printf '%s' "$label" | tr -c 'A-Za-z0-9' '_').log"

# ⛔ THE GUARD RUNS BEFORE THE COMMAND, and that ordering is the point: refusing
 after the run would
# have already destroyed the file, and refusing after a partial write would leav
e a log that is
# neither run's. Nothing is executed and nothing is written on this path.
if [ -e "$log" ] && [ "$overwrite" -eq 0 ]; then
  echo "capture-run.sh: REFUSED -- a log already exists for label '$label':" >&2
  echo "    $log" >&2
  echo "  It was NOT overwritten and the command was NOT run." >&2
  echo "  Use a different label, or pass --overwrite as the first argument if th
e reuse is deliberate." >&2
  exit 73
fi

# ⛔⛔ TIMING GOES TO ITS OWN FILE, NEVER INTO THE SUITE LOG. `bin/failure-ordin
al.sh` recovers a
# failure's ordinal by counting CLIFormatter progress dots and REFUSES unless
# `dots == tests - failures - excluded`; interleaving timing lines is precisely
the "written by a
# formatter this reader does not understand" case it exits 2 on.
# ⭐ Turning one instrument on must not cost the repository another one it alrea
dy had. The arm for
# that is `failure-ordinal.sh` calibrating on a --time log exactly as it does wi
thout it.
times="${log%.log}.times"
if [ "$timing" -eq 1 ]; then
  if [ -e "$times" ] && [ "$overwrite" -eq 0 ]; then
    echo "capture-run.sh: REFUSED -- a timing file already exists for label '$la
bel':" >&2
    echo "    $times" >&2
    echo "  It was NOT overwritten and the command was NOT run." >&2
    exit 73
  fi
  export CAPTURE_RUN_TIMES="$times"
else
  # ⛔⛔ OFF BY DEFAULT MEANS OFF, AND AN INHERITED ENV VAR IS NOT OFF. `[measur
ed 2026-09-04]` the
  # full suite ran under `--time`, so every child this suite spawned INHERITED C
APTURE_RUN_TIMES and
  # a `capture-run.sh` invoked WITHOUT `--time` still had it set. ⇒ A nested cap
tured run would have
  # written into its ANCESTOR's timing file: two runs, one file -- this script's
 own subject, one
  # process boundary out, and the guard above cannot see it because the path was
 never argv's.
  # ⭐ Found only because the suite itself was run under --time; under a plain r
un the arm asserting
  # this passes VACUOUSLY.
  unset CAPTURE_RUN_TIMES
fi

rc=0
"$@" > "$log" 2>&1 || rc=$?

summary=$(grep -oE '[0-9]+ (tests?|doctests?), [0-9]+ failures?[^|]*' "$log" | t
ail -n 1)
[ -n "$summary" ] || summary=$(tail -n 1 "$log")

if [ "$rc" -eq 0 ]; then
  printf 'ok    %-14s %s   [full log: %s]\n' "$label" "$summary" "$log"
  [ "$timing" -eq 1 ] && [ -f "$times" ] && printf '      per-test times (%s row
s): %s\n' "$(($(wc -l < "$times") - 1))" "$times"
else
  printf 'RED   %-14s rc=%s %s   [FULL LOG: %s]\n' "$label" "$rc" "$summary" "$l
og"
  # ⭐ Names are RECOVERED, not hoped for in a tail. A failing run that names no
 test is itself
  # information and says so, rather than printing nothing and looking like a qui
et failure.
  echo "failing tests (full output in $log):"
  grep -E '^\s+[0-9]+\) (test|doctest)' "$log" || echo "  (no test-name lines --
 see the tail below)"
  # ⛔⛔ AND THE TAIL IS PRINTED WHATEVER THE SHAPE, because the name-grep is a
claim about what the
  # failure LOOKS like. A compile error, a `setup_all` crash or an ExUnit-level
abort matches no
  # `N) test` line at all -- so a runner anchored only on that pattern is least
helpful exactly when
  # the breakage is worst, which is the wrong gradient. (Bound named by hermes,
2026-09-03, from the
  # same defect in its own runner.) Nothing is ever lost either way: the whole o
utput is on disk.
  echo "--- last 40 lines (full output in $log) ---"
  tail -n 40 "$log"
fi

exit "$rc"

  test "NO-SUMMARY: a truncated log is refused rather than measured", %{dir: dir
} do
    # ⛔ THE RED THIS INSTRUMENT EXISTS FOR. A log whose summary line was cut st
ill has dots, so a
    # reader that did not check would return a confident number about a partial
file.
    path = Path.join(dir, "truncated.log")
    File.write!(path, String.duplicate(".", 12) <> "\n")

    {out, status} = ordinal(path)

    assert status == 2, "a log with no summary must go RED, got #{status}"
    assert out =~ "NO-SUMMARY"
  end

  test "CALIBRATION-FAILED: dots that disagree with the summary are refused, not
 reconciled", %{
    dir: dir
  } do
    # The summary claims 40 tests; the log carries 9 dots. Interleaved, truncate
d, or written by a
    # formatter this reader does not understand — all three look like this, and
none is measurable.
    path = Path.join(dir, "interleaved.log")
    File.write!(path, String.duplicate(".", 9) <> "\n\n40 tests, 0 failures\n")

    {out, status} = ordinal(path)

    assert status == 2
    assert out =~ "CALIBRATION-FAILED"
    assert out =~ "dots=9"
    assert out =~ "expected=40"
  end

  test "timing is OFF by default -- a run without --time sets no CAPTURE_RUN_TIM
ES and writes none",
       %{dir: dir} do
    {out, 0} =
      System.cmd(
        "bash",
        [@capture, "plain", "bash", "-c", ~s|echo "TIMES=[${CAPTURE_RUN_TIMES:-}
]"|],
        env: [{"CAPTURE_RUN_DIR", dir}],
        stderr_to_stdout: true
      )

    refute out =~ "per-test times"
    assert File.read!(Path.join(dir, "plain.log")) =~ "TIMES=[]"
    refute File.exists?(Path.join(dir, "plain.times"))
  end

  test "--time points the formatter at its OWN file, beside the log and never in
side it", %{
    dir: dir
  } do
    {_out, 0} =
      System.cmd(
        "bash",
        [@capture, "--time", "timed", "bash", "-c", ~s|echo "TIMES=[${CAPTURE_RU
N_TIMES:-}]"|],
        env: [{"CAPTURE_RUN_DIR", dir}],
        stderr_to_stdout: true
      )

    log = File.read!(Path.join(dir, "timed.log"))

    # ⛔ THE PATH IS A SIBLING OF THE LOG, NOT THE LOG. If these were ever the s
ame file the timing
    # rows would land in the suite stream and `failure-ordinal.sh` would refuse
every log we write.
    assert log =~ "TIMES=[#{Path.join(dir, "timed.times")}]"
    refute log =~ "timed.log]"
  end

  test "the formatter writes one row per finished test, and a test that never ra
n is named not zeroed",
       %{dir: dir} do
    path = Path.join(dir, "unit.times")
    {:ok, pid} = GenServer.start_link(CaptureTimingFormatter, capture_run_times:
 path)

    GenServer.cast(pid, {:test_finished, %ExUnit.Test{module: A, name: :"test on
e", time: 1234}})
    GenServer.cast(pid, {:test_finished, %ExUnit.Test{module: B, name: :"test tw
o", time: nil}})

    # ⛔ THE CASE THAT ACTUALLY OCCURS: an excluded test arrives with `time: 0`,
 not `nil`, so a
    # guard on `nil` alone is green about a case the suite never produces. `[mea
sured]` 549 rows
    # against "549 tests, 1 excluded" — the extra row was the excluded test, rea
ding `0`.
    GenServer.cast(
      pid,
      {:test_finished,
       %ExUnit.Test{module: C, name: :"test three", time: 0, state: {:excluded,
"tag"}}}
    )

    GenServer.cast(pid, {:suite_finished, %{}})
    _ = :sys.get_state(pid)

    rows = path |> File.read!() |> String.split("\n", trim: true)

    assert ["# us\tmodule\ttest" | body] = rows
# ⭐ THE SCRIPT WRITTEN BECAUSE A PIPELINE HID 11 FAILURES WAS HIDING THE IDENTI
TY OF FAILURES IT
# CORRECTLY DETECTED. `[measured 2026-09-03]` it cost three separate diagnosis c
ycles in one day --
# the rc discipline was right and the evidence was truncated, which reads as a c
lean report.
# ⭐⭐ AND THE FIX ALREADY EXISTED IN THIS REPOSITORY: `land-round.sh:38-42` has
 written the full
# output to `tmp/land-gate-<label>.log` since 2026-08-25, for this exact reason,
 with the comment
# saying so. It could not fire here because AN ARTIFACT ONLY FIRES WHERE IT IS I
NSTALLED -- a
# correction filed in one runner does not reach the next runner someone writes.
gate() { local name="$1"; shift
  # ⭐ ONE CAPTURE, SHARED. `capture-run.sh` keeps the whole output, prints the
summary and the log
  # PATH, recovers the failing test names, and exits with THE COMMAND'S rc -- so
 this function is
  # left holding only the red flag, which is all it was ever meant to own.
  # ⭐ `--overwrite` IS DELIBERATE AND IS THE ONLY SUCH CALLER IN THE TREE. This
 script's four
  # labels (`deps.get`, `compile`, `test`, `format`) are FIXED, so every invocat
ion of `bump-pin.sh`
  # reuses all four -- a second bump would be refused by `capture-run.sh`'s exis
ting-log guard with
  # nothing wrong. ⛔ The reuse is safe HERE for a reason that does not generali
se: these logs are
  # consumed inside the same run (the summary prints the path, then the run rest
ores or commits),
  # so no later reader is ever pointed at one. An ad-hoc analysis log is the opp
osite, and that is
  # the case the guard defends.
  bash "$(dirname "${BASH_SOURCE[0]}")/capture-run.sh" --overwrite "$name" "$@"
|| RED=1
}

