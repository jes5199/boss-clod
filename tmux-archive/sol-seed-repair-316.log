defmodule CommonplaceNext.Workspace.SeedTest do
  use ExUnit.Case, async: true

  alias Commonplace.Markdown

  # ⚠️  CONTRACT PIN, NOT A CRASH DEMO -- and the distinction is the point.
  # `Seed.seed_markdown/3` is private and its only two callers pass non-empty mo
dule
  # attributes, so the empty-markdown clause it now carries is UNREACHABLE throu
gh today's
  # callers and CANNOT be demonstrated end to end. Building a public caller so a
 test could
  # reach it would test the caller I invented, not the defect.
  # ⇒ What CAN go red is the upstream fact that made the old `[command] = ...` d
estructure
  #    crashable at all. This dies the day `new_content/2` returns [nil], raises
, or drops
  #    its empty-string clause -- which is a real death condition, not decoratio
n.
  test "seeding empty markdown yields no command, which the seeder must not dest
ructure" do
    assert Markdown.new_content("seed:genesis:doc", "") == []

    refute match?([_command], Markdown.new_content("seed:genesis:doc", ""))

    assert [_command] = Markdown.new_content("seed:genesis:doc", "# Not empty\n"
)
  end
end

