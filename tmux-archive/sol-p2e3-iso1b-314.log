  @doc "Checks a request and returns either an updated table or
its first occurrence."
  def check(%__MODULE__{} = table, %Request{} = request) do
    with {:ok, canonical_body} <- Request.encode(request) do
      case Map.fetch(table.entries, request.request_id) do
        :error -> {:new, insert(table, request.request_id, canon
ical_body, request)}
        {:ok, {^canonical_body, first}} -> {:duplicate, first}
        {:ok, {_other_body, _first}} -> {:error, Portable.error(
:request_id_conflict)}
      end
    end
  end

  def check(_table, _request), do: {:error, Portable.error(:inva
lid_request)}

  defp insert(table, request_id, canonical_body, request) do
    table =
      if length(table.order) == table.limit do
        [oldest | rest] = table.order
        %{table | order: rest, entries: Map.delete(table.entries
, oldest)}
      else
        table
      end

    %{
      table
      | order: table.order ++ [request_id],
        entries: Map.put(table.entries, request_id, {canonical_b
ody, request})
    }
  end
end

