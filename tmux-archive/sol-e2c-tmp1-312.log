diff --git a/test/commonplace_next/test_fixtures_test.exs b/test
/commonplace_next/test_fixtures_test.exs
new file mode 100644
index 0000000000000000000000000000000000000000..89fd02b3510ccfdc
c3e9e80193274bf69ce03d16
--- /dev/null
+++ b/test/commonplace_next/test_fixtures_test.exs
@@ -0,0 +1,60 @@
+defmodule CommonplaceNext.TestFixturesTest do
+  use ExUnit.Case, async: true
+
+  alias CommonplaceNext.{SecondBeam, TestFixtures}
+
+  test "fixture roots do not collide across fresh VMs" do
+    first = root_from_fresh_vm("collision-arm")
+    File.mkdir_p!(first)
+    marker = Path.join(first, "stale-marker")
+    File.write!(marker, "from the old run")
+
+    on_exit(fn -> File.rm_rf!(first) end)
+
+    second = root_from_fresh_vm("collision-arm")
+
+    refute second == first
+    assert File.read!(marker) == "from the old run"
+  end
+
+  test "cleanup waits for a captured child pid before removing
its root" do
+    root = TestFixtures.unique_tmp_root("wait-arm")
+    File.mkdir_p!(root)
+    executable = System.find_executable("sh") || raise "sh exec
utable missing"
+
+    {port, os_pid} =
+      SecondBeam.spawn_and_pid(executable, [
+        :binary,
+        :exit_status,
+        {:args, ["-c", "sleep 0.5"]}
+      ])
+
+    true = Port.close(port)
+
+    on_exit(fn ->
+      SecondBeam.reap(os_pid)
+      File.rm_rf!(root)
+    end)
+
+    SecondBeam.wait_gone!(os_pid, 2_000)
+    File.rm_rf!(root)
+
+    refute SecondBeam.alive?(os_pid),
+           "cleanup returned while child pid #{os_pid} was stil
l alive"
+
+    refute File.exists?(root)
+  end
+
+  defp root_from_fresh_vm(tag) do
+    executable = System.find_executable("elixir") || raise "eli
xir executable missing"
+    helper = Path.expand("../support/test_fixtures.ex", __DIR__
)
+
+    expression = """
+    Code.require_file(#{inspect(helper)})
+    IO.write(CommonplaceNext.TestFixtures.unique_tmp_root(#{ins
pect(tag)}))
+    """
+
+    {root, 0} = System.cmd(executable, ["-e", expression])
+    root
+  end
+end
