+defmodule CommonplaceNext.SharedDocumentMirrorTest do
+  use ExUnit.Case, async: false
+
+  @moduletag :integration
+
+  alias Commonplace.DocHost
+  alias Commonplace.LogStore.SQLite
+  alias CommonplaceNext.{Hosts, Organization, Realm, Workspace}
+  alias CommonplaceNext.Cell.Supervisor, as: CellSupervisor
+  alias CommonplaceNext.Organization.{EditorPlacement, ExternalGrant, Identity,
 Membership}
+  alias CommonplaceNext.Realm.Gateway.{Bootstrap, Listener}
+  alias CommonplaceNext.Realm.{Gateway, Router}
+  alias CommonplaceNext.Workspace.Seed
+
+  @organization_b_id "commonplace-next-share-2-organization-b"
+
+  defmodule Remote do
+    use GenServer
+
+    def start_link(options), do: GenServer.start_link(__MODULE__, options)
+    def command(remote, command), do: GenServer.call(remote, {:command, command
}, 30_000)
+    def os_pid(remote), do: GenServer.call(remote, :os_pid)
+
+    @impl true
+    def init(options) do
+      executable = System.find_executable("elixir") || raise "elixir executable
 missing"
+      control_port = free_port()
+
+      code_path_args =
+        :code.get_path()
+        |> Enum.flat_map(fn path -> ["-pa", List.to_string(path)] end)
+
+      args = code_path_args ++ ["-e", Keyword.fetch!(options, :script)]
+
+      {port, os_pid} =
+        CommonplaceNext.SecondBeam.spawn_and_pid(executable, [
+          :binary,
+          :exit_status,
+          {:packet, 4},
+          {:args, args},
+          {:env,
+           [
+             {~c"COMMONPLACE_NEXT_CONTROL_PORT", Integer.to_charlist(control_po
rt)},
+             {~c"COMMONPLACE_NEXT_ORGANIZATION_ID",
+              to_charlist(Keyword.fetch!(options, :organization_id))},
+             {~c"COMMONPLACE_NEXT_PEER_WORKSPACE_CELL_ID",
+              to_charlist(Keyword.fetch!(options, :peer_workspace_cell_id))}
+           ]},
+          {:cd, Keyword.fetch!(options, :data_dir)}
+        ])
+
+      true = Port.command(port, Keyword.fetch!(options, :bootstrap))
+      true = Port.close(port)
+
+      with {:ok, control} <-
+             await_control(control_port, System.monotonic_time(:millisecond) +
30_000),
+           {:ok, "READY"} <- :gen_tcp.recv(control, 0, 30_000) do
+        {:ok, %{control: control, os_pid: os_pid}}
+      else
+        {:error, reason} -> {:stop, {:child_start_error, reason}}
+      end
+    end
+
+    @impl true
+    def handle_call(:os_pid, _from, state), do: {:reply, state.os_pid, state}
+
+    def handle_call({:command, command}, _from, state) do
