+defmodule CommonplaceNext.SharedDocumentMirrorTest do
+  use ExUnit.Case, async: false
+
+  @moduletag :integration
+
+  alias Commonplace.DocHost
+  alias Commonplace.LogStore.SQLite
+  alias CommonplaceNext.{Hosts, Organization, Realm, Workspace}
+  alias CommonplaceNext.Cell.Supervisor, as: CellSupervisor
+  alias CommonplaceNext.Organization.{EditorPlacement, ExternalGrant, Identity,
 Membership}
+  alias CommonplaceNext.Realm.Gateway.{Bootstrap, Listener}
+  alias CommonplaceNext.Realm.{Gateway, Router}
+  alias CommonplaceNext.Workspace.Seed
+
+  @organization_b_id "commonplace-next-share-2-organization-b"
+
+  defmodule Remote do
+    use GenServer
+
+    def start_link(options), do: GenServer.start_link(__MODULE__, options)
+    def command(remote, command), do: GenServer.call(remote, {:command, command
}, 30_000)
+    def os_pid(remote), do: GenServer.call(remote, :os_pid)
+
+    @impl true
+    def init(options) do
+      executable = System.find_executable("elixir") || raise "elixir executable
 missing"
+      control_port = free_port()
+
+      code_path_args =
+        :code.get_path()
+        |> Enum.flat_map(fn path -> ["-pa", List.to_string(path)] end)
+
+      args = code_path_args ++ ["-e", Keyword.fetch!(options, :script)]
+
+      {port, os_pid} =
+        CommonplaceNext.SecondBeam.spawn_and_pid(executable, [
+          :binary,
+          :exit_status,
+          {:packet, 4},
+          {:args, args},
+          {:env,
+           [
+             {~c"COMMONPLACE_NEXT_CONTROL_PORT", Integer.to_charlist(control_po
rt)},
+             {~c"COMMONPLACE_NEXT_ORGANIZATION_ID",
+              to_charlist(Keyword.fetch!(options, :organization_id))},
+             {~c"COMMONPLACE_NEXT_PEER_WORKSPACE_CELL_ID",
+              to_charlist(Keyword.fetch!(options, :peer_workspace_cell_id))}
+           ]},
+          {:cd, Keyword.fetch!(options, :data_dir)}
+        ])
+
+      true = Port.command(port, Keyword.fetch!(options, :bootstrap))
+      true = Port.close(port)
+
+      with {:ok, control} <-
+             await_control(control_port, System.monotonic_time(:millisecond) +
30_000),
+           {:ok, "READY"} <- :gen_tcp.recv(control, 0, 30_000) do
+        {:ok, %{control: control, os_pid: os_pid}}
+      else
+        {:error, reason} -> {:stop, {:child_start_error, reason}}
+      end
+    end
+
+    @impl true
+    def handle_call(:os_pid, _from, state), do: {:reply, state.os_pid, state}
+
+    def handle_call({:command, command}, _from, state) do
+      :ok = :gen_tcp.send(state.control, command)
+
+      case :gen_tcp.recv(state.control, 0, 25_000) do
+        {:ok, reply} when command == "stop" ->
+          :ok = :gen_tcp.close(state.control)
+          {:stop, :normal, {:ok, reply}, state}
+
+        {:ok, reply} ->
+          {:reply, {:ok, reply}, state}
+
+        {:error, reason} ->
+          {:reply, {:error, {:child_exit, reason}}, state}
+      end
+    end
+
+    defp free_port do
+      {:ok, socket} = :gen_tcp.listen(0, [:binary, active: false, reuseaddr: tr
ue])
+      {:ok, {_ip, port}} = :inet.sockname(socket)
+      :ok = :gen_tcp.close(socket)
+      port
+    end
+
+    defp await_control(port, deadline) do
+      case :gen_tcp.connect({127, 0, 0, 1}, port, [:binary, active: false, pack
et: 4], 50) do
+        {:ok, socket} ->
+          {:ok, socket}
+
+        {:error, reason} ->
+          if System.monotonic_time(:millisecond) >= deadline do
+            {:error, reason}
+          else
+            Process.sleep(10)
+            await_control(port, deadline)
+          end
+      end
+    end
+  end
+
+  setup do
+    :ok = stop_realm()
+    stop_sqlite_children()
+
+    root = CommonplaceNext.TestFixtures.unique_tmp_root("share-2")
+    parent_dir = Path.join(root, "organization-a")
+    remote_dir = Path.join(root, "organization-b")
+    File.mkdir_p!(parent_dir)
+    File.mkdir_p!(remote_dir)
+
+    previous = %{
+      log: Application.get_env(:commonplace_log, SQLite),
+      realm: Application.get_env(:commonplace_next, Realm),
+      gateway: Application.get_env(:commonplace_next, Gateway),
+      organization: Application.get_env(:commonplace_next, Organization)
+    }
+
+    Application.put_env(:commonplace_log, SQLite, data_dir: parent_dir)
+    Application.put_env(:commonplace_next, Realm, cells: :all, remote: %{})
+    Application.put_env(:commonplace_next, Gateway, port: 0, realm_id: "commonp
lace-next")
+    {:ok, _realm} = Supervisor.restart_child(CommonplaceNext.Supervisor, Realm)
+
+    {:ok, organization_a} = Organization.configured()
+    workspace_a_cell_id = Identity.space(organization_a).workspace_cell_id
+    {:ok, workspace_a_hosts} = CellSupervisor.hosts(workspace_a_cell_id)
+    {:ok, owner_member_id} = Organization.configured_owner_member_id()
+
+    {:ok, owner_a} =
+      Membership.resolve_owner(organization_a,
+        hosts: workspace_a_hosts,
+        member_id: owner_member_id
+      )
+
+    editor_b =
+      EditorPlacement.entry(
+        @organization_b_id,
+        owner_member_id,
+        Membership.initial_generation()
+      )
+
+    document_id = Seed.ids(organization_a).welcome_document_id
+
+    membership_epoch =
+      Membership.derive_membership_epoch(
+        @organization_b_id,
+        owner_member_id,
+        Membership.initial_generation()
+      )
+
+    grant = grant!(owner_a, editor_b.cell_id, document_id, membership_epoch)
+    token = Base.url_encode64(:crypto.strong_rand_bytes(32), padding: false)
+
+    {:ok, bootstrap} =
+      Bootstrap.fetch("127.0.0.1", Listener.bootstrap_port(), editor_b.cell_id,
 token)
+
+    {:ok, bootstrap_frame} = Bootstrap.encode_material(bootstrap)
+
+    {:ok, remote} =
+      Remote.start_link(
+        bootstrap: bootstrap_frame,
+        data_dir: remote_dir,
+        organization_id: @organization_b_id,
+        peer_workspace_cell_id: workspace_a_cell_id,
+        script: remote_script()
+      )
+
+    remote_os_pid = Remote.os_pid(remote)
+
+    on_exit(fn ->
+      stop_remote(remote, remote_os_pid)
+      :ok = stop_realm()
+      stop_sqlite_children()
+      restore_env(:commonplace_log, SQLite, previous.log)
+      restore_env(:commonplace_next, Realm, previous.realm)
+      restore_env(:commonplace_next, Gateway, previous.gateway)
+      restore_env(:commonplace_next, Organization, previous.organization)
+      File.rm_rf!(root)
+      :ok = restart_realm()
+    end)
+
+    %{
+      document_id: document_id,
+      editor_b: editor_b,
+      grant: grant,
+      membership_epoch: membership_epoch,
+      owner_a: owner_a,
+      remote: remote,
+      workspace_a_cell_id: workspace_a_cell_id,
+      workspace_a_hosts: workspace_a_hosts
+    }
+  end
+
+  test "S5 B opens A's shared document and edits converge canonically in both d
irections",
+       context do
+    assert {:ok, opened} = remote_open(context)
+    from_b = "share-2-from-b-#{System.unique_integer([:positive])}"
+    assert {:ok, "ok"} = Remote.command(context.remote, "append-mirror:" <> fro
m_b)
+    assert eventually(fn -> canonical_text(context) =~ from_b end)
+    assert eventually(fn -> remote_status(context) =~ "synced" end)
+
+    from_a = "share-2-from-a-#{System.unique_integer([:positive])}"
+    append_canonical!(context, from_a)
+    assert eventually(fn -> remote_text(context) =~ from_a end), remote_status(
context)
+    assert canonical_text(context) =~ from_b
+    assert remote_text(context) =~ from_a
+    assert opened.mirror_document_id != context.document_id
+  end
+
+  test "S6 revoked before open is named and revoked after open stops sync while
 disclosed content remains",
+       context do
+    assert {:ok, %{revoked: true}} =
+             ExternalGrant.revoke(context.owner_a, context.grant.grant_id)
+
+    assert {:error, :grant_revoked} = ExternalGrant.admission(context.editor_b.
cell_id)
+
+    assert {:ok, "error|revoked"} = Remote.command(context.remote, open_command
(context))
+
+    _replacement =
+      grant!(
+        context.owner_a,
+        context.editor_b.cell_id,
+        context.document_id,
+        context.membership_epoch
+      )
+
+    assert {:ok, _opened} = remote_open(context)
+    disclosed = remote_text(context)
+
+    {:ok, active} = ExternalGrant.admission(context.editor_b.cell_id)
+    assert {:ok, %{revoked: true}} = ExternalGrant.revoke(context.owner_a, acti
ve.grant_id)
+
+    marker = "share-2-stays-local-#{System.unique_integer([:positive])}"
+    started_at = System.monotonic_time(:second)
+    assert {:ok, "ok"} = Remote.command(context.remote, "append-mirror:" <> mar
ker)
+    assert eventually(fn -> remote_status(context) =~ "blocked" end)
+    assert System.monotonic_time(:second) - started_at < 60
+    assert remote_text(context) =~ disclosed
+    assert remote_text(context) =~ marker
+    refute canonical_text(context) =~ marker
+  end
+
+  test "S7 B's shared mirror records A as home and never makes D canonical in B
's workspace",
+       context do
+    assert {:ok, opened} = remote_open(context)
+    marker = "share-2-not-canonical-in-b-#{System.unique_integer([:positive])}"
+    assert {:ok, "ok"} = Remote.command(context.remote, "append-mirror:" <> mar
ker)
+    assert eventually(fn -> canonical_text(context) =~ marker end)
+
+    assert {:ok, relationship} = remote_relationship(context)
+    assert relationship.canonical_document_id == context.document_id
+    assert relationship.canonical_version_document_id == context.document_id
+    assert canonical_snapshot(context).home_cell_id == context.workspace_a_cell
_id
+    assert {:ok, "absent"} = Remote.command(context.remote, "b-canonical-entry"
)
+    assert opened.relationship_id == relationship.relationship_id
+    assert opened.target_workspace_cell_id == context.workspace_a_cell_id
+  end
+
+  defp grant!(owner, grantee_cell_id, document_id, membership_epoch) do
+    {:ok, grant} =
+      ExternalGrant.create(owner, %{
+        grantee_cell_id: grantee_cell_id,
+        document_id: document_id,
+        actions: ExternalGrant.actions(),
+        membership_epoch: membership_epoch,
+        expires_at: System.system_time(:second) + 3_600,
+        grant_id: Router.request_id()
+      })
+
+    grant
+  end
+
+  defp remote_open(context) do
+    case Remote.command(context.remote, open_command(context)) do
+      {:ok, "ok|" <> encoded} ->
+        [mirror_document_id, relationship_id] = String.split(encoded, "|", part
s: 2)
+
+        {:ok,
+         %{
+           mirror_document_id: mirror_document_id,
+           relationship_id: relationship_id,
+           target_workspace_cell_id: context.workspace_a_cell_id
+         }}
+
+      {:ok, "error|" <> reason} ->
+        {:error, reason}
+
+      other ->
+        other
+    end
+  end
+
+  defp open_command(context),
+    do: "open:#{context.workspace_a_cell_id}:#{context.document_id}"
+
+  defp remote_text(context) do
+    assert {:ok, "ok|" <> text} = Remote.command(context.remote, "mirror-text")
+    text
+  end
+
+  defp remote_status(context) do
+    assert {:ok, "ok|" <> status} = Remote.command(context.remote, "status")
+    status
+  end
+
+  defp remote_relationship(context) do
+    case Remote.command(context.remote, "relationship") do
+      {:ok, "ok|" <> encoded} ->
+        [relationship_id, canonical_document_id, canonical_version_document_id]
 =
+          String.split(encoded, "|", parts: 3)
+
+        {:ok,
+         %{
+           relationship_id: relationship_id,
+           canonical_document_id: canonical_document_id,
+           canonical_version_document_id: canonical_version_document_id
+         }}
+
+      other ->
+        other
+    end
+  end
+
+  defp append_canonical!(context, marker) do
+    text = canonical_text(context)
+
+    assert {:ok, _receipt} =
+             Workspace.edit_markdown(
+               context.workspace_a_hosts,
+               context.document_id,
+               [{:insert, String.length(text), "\n#{marker}\n"}],
+               "share-2:a:" <> Router.request_id()
+             )
+  end
+
+  defp canonical_text(context) do
+    snapshot = canonical_snapshot(context)
+    {:ok, text} = Commonplace.Markdown.text(snapshot.content)
+    text
+  end
+
+  defp canonical_snapshot(context) do
+    {:ok, document} =
+      Hosts.open_document(context.workspace_a_hosts, context.document_id, clien
t_id: 1)
+
+    {:ok, snapshot} = DocHost.snapshot(document)
+    snapshot
+  end
+
+  defp eventually(fun, attempts \\ 500)
+  defp eventually(_fun, 0), do: false
+
+  defp eventually(fun, attempts) do
+    if fun.() do
+      true
+    else
+      Process.sleep(20)
+      eventually(fun, attempts - 1)
+    end
+  end
+
+  defp stop_remote(remote, os_pid) do
+    if Process.alive?(remote) do
+      try do
+        _ = Remote.command(remote, "stop")
+      catch
+        :exit, _reason -> :ok
+      end
+    end
+
+    CommonplaceNext.SecondBeam.wait_gone!(os_pid)
+  end
+
+  defp stop_realm do
+    case Supervisor.terminate_child(CommonplaceNext.Supervisor, Realm) do
+      :ok -> :ok
+      {:error, :not_found} -> :ok
+    end
+  end
+
+  defp stop_sqlite_children do
+    Registry.select(SQLite.Registry, [{{:_, :"$1", :_}, [], [:"$1"]}])
+    |> Enum.each(fn child ->
+      :ok = DynamicSupervisor.terminate_child(SQLite.DynamicSupervisor, child)
+    end)
+  end
+
+  defp restart_realm(attempts \\ 20)
+  defp restart_realm(0), do: {:error, :realm_restart_exhausted}
+
+  defp restart_realm(attempts) do
+    case Supervisor.restart_child(CommonplaceNext.Supervisor, Realm) do
+      {:ok, _realm} ->
+        :ok
+
+      {:error, _reason} ->
+        :ok = stop_realm()
+        stop_sqlite_children()
+        Process.sleep(25)
+        restart_realm(attempts - 1)
+    end
+  end
+
+  defp restore_env(application, key, nil), do: Application.delete_env(applicati
on, key)
+  defp restore_env(application, key, value), do: Application.put_env(applicatio
n, key, value)
+
+  defp remote_script do
+    ~S"""
+    defmodule Share2Remote do
+      alias CommonplaceNext.{Hosts, Organization, Workspace, WorkspaceCell}
+      alias CommonplaceNext.Cell.Supervisor, as: CellSupervisor
+      alias CommonplaceNext.EditorCell.Mirrors
+      alias CommonplaceNext.Organization.EditorPlacement
+      alias CommonplaceNext.Realm.{EditorIssuer, Router}
+      alias CommonplaceNext.Realm.Gateway.{Bootstrap, Credentials}
+
+      def run do
+        {:ok, bootstrap} = receive_bootstrap()
+        organization_id = System.fetch_env!("COMMONPLACE_NEXT_ORGANIZATION_ID")
+        Application.put_env(:commonplace_next, Organization, id: organization_i
d, name: "Organization B")
+        {:ok, _credentials} = Credentials.start_link([])
+        :ok = Credentials.provision_client_session(Map.merge(bootstrap.transpor
t, %{token: bootstrap.token}))
+        configure(bootstrap)
+        {:ok, _} = Application.ensure_all_started(:commonplace_next)
+        {:ok, listener} = :gen_tcp.listen(control_port(), [:binary, active: fal
se, packet: 4, reuseaddr: true])
+        {:ok, control} = :gen_tcp.accept(listener, 30_000)
+        :ok = :gen_tcp.close(listener)
+        :ok = :gen_tcp.send(control, "READY")
+        loop(control, nil)
+      end
+
+      defp loop(control, opened) do
+        case :gen_tcp.recv(control, 0, 30_000) do
+          {:ok, "open:" <> ids} ->
+            [workspace_cell_id, document_id] = String.split(ids, ":", parts: 2)
+            entry = EditorPlacement.first_entry() |> elem(1)
+            session_cell_id = "01990000-0000-7000-8000-00000000b002"
+            {:ok, issued} = EditorIssuer.issue_cell_open(Router.request_id(), s
ession_cell_id, entry.cell_id, entry.root_directory_id)
+            {:ok, proof} = Commonplace.Cell.Proof.new(%{"format" => Commonplace
.Cell.Proof.format(), "token" => issued.token})
+
+            case Mirrors.open(Router.handle(entry.cell_id) |> elem(1), {workspa
ce_cell_id, document_id}, admission: {session_cell_id, [proof]}) do
+              {:ok, result} ->
+                :ok = :gen_tcp.send(control, "ok|#{result.mirror_document_id}|#
{result.relationship_id}")
+                loop(control, %{result: result, workspace_cell_id: workspace_ce
ll_id, document_id: document_id, entry: entry})
+
+              {:error, %{kind: kind}} ->
+                :ok = :gen_tcp.send(control, "error|#{kind}")
+                loop(control, opened)
+
+              {:error, %{code: code}} ->
+                :ok = :gen_tcp.send(control, "error|#{code}")
+                loop(control, opened)
+            end
+
+          {:ok, "append-mirror:" <> marker} ->
+            {:ok, hosts} = CellSupervisor.hosts(opened.entry.cell_id)
+            text = text(hosts, opened.result.mirror_document_id)
+            {:ok, _} = Workspace.edit_markdown(hosts, opened.result.mirror_docu
ment_id, [{:insert, String.length(text), "\n#{marker}\n"}], "share-2:b:" <> Rout
er.request_id())
+            :ok = :gen_tcp.send(control, "ok")
+            loop(control, opened)
+
+          {:ok, "mirror-text"} ->
+            {:ok, hosts} = CellSupervisor.hosts(opened.entry.cell_id)
+            :ok = :gen_tcp.send(control, "ok|" <> text(hosts, opened.result.mir
ror_document_id))
+            loop(control, opened)
+
+          {:ok, "status"} ->
+            key = {opened.entry.cell_id, opened.workspace_cell_id, opened.docum
ent_id}
+            {:ok, status} = Mirrors.status(Router.handle(opened.entry.cell_id)
|> elem(1), key)
+            :ok = :gen_tcp.send(control, "ok|#{status.state}|#{status.reason}")
+            loop(control, opened)
+
+          {:ok, "relationship"} ->
+            key = {opened.entry.cell_id, opened.workspace_cell_id, opened.docum
ent_id}
+            {:ok, relationship} = Mirrors.relationship(Router.handle(opened.ent
ry.cell_id) |> elem(1), key)
+            encoded = Enum.join([relationship.relationship_id, relationship.can
onical_document_id, relationship.canonical_version.document_id], "|")
+            :ok = :gen_tcp.send(control, "ok|" <> encoded)
+            loop(control, opened)
+
+          {:ok, "b-canonical-entry"} ->
+            {:ok, hosts} = CellSupervisor.hosts(WorkspaceCell.descriptor().cell
_id)
+            answer = case Hosts.open_document(hosts, opened.document_id, client
_id: 1) do
+              {:error, %{kind: :log_not_found}} -> "absent"
+              {:ok, _host} -> "present"
+              other -> "error|#{inspect(other)}"
+            end
+            :ok = :gen_tcp.send(control, answer)
+            loop(control, opened)
+
+          {:ok, "stop"} ->
+            :ok = :gen_tcp.send(control, "ok")
+            :ok = Application.stop(:commonplace_next)
+
+          _ -> :ok
+        end
+      end
+
+      defp text(hosts, document_id) do
+        {:ok, host} = Hosts.open_document(hosts, document_id, client_id: 1)
+        {:ok, snapshot} = Commonplace.DocHost.snapshot(host)
+        {:ok, text} = Commonplace.Markdown.text(snapshot.content)
+        text
+      end
+
+      defp configure(bootstrap) do
+        organization_id = System.fetch_env!("COMMONPLACE_NEXT_ORGANIZATION_ID")
+        Logger.configure(level: :emergency)
+        Application.put_env(:commonplace_next, Organization, id: organization_i
d, name: "Organization B")
+        Application.put_env(:commonplace_log, Commonplace.LogStore.SQLite, data
_dir: File.cwd!())
+        Application.put_env(:commonplace_next, CommonplaceNext.EditorCell,
+          canonical_poll_ms: 50,
+          on_destination_advanced: :merge
+        )
