+defmodule CommonplaceNext.Organization.ExternalGrant do
+  @moduledoc """
+  A revocable document entitlement issued by one Organization owner to a foreig
n Editor Cell.
+
+  Grant records live in the granting Organization's Workspace Cell. The grant i
tself is keyed by
+  `Identity.derive(organization_id, :external_grant, grant_id)`; a per-grantee
index, under the
+  same facet, makes those records discoverable from the cell id presented at bo
otstrap.
+  """
+
+  alias Commonplace.DocHost
+  alias Commonplace.Markdown
+  alias CommonplaceNext.Cell.Supervisor, as: CellSupervisor
+  alias CommonplaceNext.Hosts
+  alias CommonplaceNext.Organization.{Identity, Membership}
+  alias CommonplaceNext.Yjs.Author
+
+  @actions [
+    :"document.sync.summary",
+    :"document.sync.offer",
+    :"document.sync.export",
+    :"document.read.content",
+    :"document.sync.subscribe"
+  ]
+
+  @enforce_keys [
+    :organization_id,
+    :grantee_cell_id,
+    :document_id,
+    :actions,
+    :membership_epoch,
+    :expires_at,
+    :grant_id,
+    :revoked
+  ]
+  defstruct @enforce_keys
+
+  @type action :: unquote(Enum.reduce(@actions, &{:|, [], [&1, &2]}))
+  @type t :: %__MODULE__{
+          organization_id: binary(),
+          grantee_cell_id: binary(),
+          document_id: binary(),
+          actions: [action()],
+          membership_epoch: binary(),
+          expires_at: integer(),
+          grant_id: binary(),
+          revoked: boolean()
+        }
+
+  @doc "The exact document-grant actions accepted by this record format."
+  def actions, do: @actions
+
+  @doc "Creates and persists a grant. The caller supplies the already-resolved
owner Membership."
+  def create(%Membership{role: :owner, organization_id: organization_id}, attrs
)
+      when is_map(attrs) do
+    if Map.get(attrs, :organization_id, organization_id) == organization_id do
+      create_for_owner(organization_id, attrs)
+    else
+      {:error, :not_owner}
+    end
+  end
+
+  def create(%Membership{}, _attrs), do: {:error, :not_owner}
+  def create(_membership, _attrs), do: {:error, :not_owner}
+
+  defp create_for_owner(organization_id, attrs) do
+    grant = %__MODULE__{
+      organization_id: organization_id,
+      grantee_cell_id: Map.get(attrs, :grantee_cell_id),
+      document_id: Map.get(attrs, :document_id),
+      actions: Map.get(attrs, :actions),
+      membership_epoch: Map.get(attrs, :membership_epoch),
+      expires_at: Map.get(attrs, :expires_at),
+      grant_id: Map.get(attrs, :grant_id),
+      revoked: false
+    }
+
+    with :ok <- validate(grant),
+         {:ok, hosts} <- workspace_hosts(organization_id),
+         :ok <- create_record(hosts, grant),
+         :ok <- append_index(hosts, grant) do
+      {:ok, grant}
+    end
+  end
+
+  @doc "Marks a persisted grant revoked. Records are retained and never deleted
."
+  def revoke(%Membership{role: :owner, organization_id: organization_id}, grant
_id)
+      when is_binary(grant_id) do
+    with {:ok, hosts} <- workspace_hosts(organization_id),
+         {:ok, grant, host} <- fetch_from_hosts(hosts, organization_id, grant_i
d),
+         true <- grant.organization_id == organization_id,
+         :ok <- append_revocation(host, grant) do
+      {:ok, %{grant | revoked: true}}
+    else
+      false -> {:error, :not_owner}
+      {:error, reason} -> {:error, reason}
+    end
+  end
+
+  def revoke(%Membership{}, _grant_id), do: {:error, :not_owner}
+  def revoke(_membership, _grant_id), do: {:error, :not_owner}
+
+  @doc "Finds the grant state that controls bootstrap admission for a foreign E
ditor Cell."
+  def admission(grantee_cell_id) when is_binary(grantee_cell_id) do
+    with {:ok, organization_id} <- configured_organization_id(),
+         {:ok, hosts} <- workspace_hosts(organization_id),
+         {:ok, grant_ids} <- grant_ids(hosts, organization_id, grantee_cell_id)
 do
+      grants =
+        Enum.flat_map(grant_ids, fn grant_id ->
+          case fetch_from_hosts(hosts, organization_id, grant_id) do
+            {:ok, grant, _host} -> [grant]
+            _unreadable -> []
+          end
+        end)
+
+      classify_admission(grants)
+    else
+      {:error, :absent} -> {:error, :unknown_cell}
+      {:error, reason} -> {:error, reason}
+    end
+  end
+
+  def admission(_grantee_cell_id), do: {:error, :unknown_cell}
+
+  @doc "Checks a foreign source against its exact document and verb entitlement
."
+  def authorize(grantee_cell_id, document_id, verb)
+      when is_binary(grantee_cell_id) and is_binary(document_id) and is_binary(
verb) do
+    case admission(grantee_cell_id) do
+      {:ok, grant} ->
+        cond do
+          grant.document_id != document_id -> {:error, :unentitled}
+          verb_atom(verb) not in grant.actions -> {:error, :unentitled}
+          true -> {:ok, grant}
+        end
+
+      {:error, reason} ->
+        {:error, reason}
+    end
+  end
+
+  def authorize(_grantee_cell_id, _document_id, _verb), do: {:error, :unentitle
d}
+
+  @doc "Reads one grant record by its public grant id."
+  def fetch(organization_id, grant_id)
+      when is_binary(organization_id) and is_binary(grant_id) do
+    with {:ok, hosts} <- workspace_hosts(organization_id),
+         {:ok, grant, _host} <- fetch_from_hosts(hosts, organization_id, grant_
id) do
+      {:ok, grant}
+    end
+  end
+
+  def document_id(organization_id, grant_id)
+      when is_binary(organization_id) and is_binary(grant_id),
+      do: Identity.derive(organization_id, :external_grant, grant_id)
+
+  defp validate(%__MODULE__{} = grant) do
+    valid =
+      Enum.all?(
+        [
+          grant.organization_id,
+          grant.grantee_cell_id,
+          grant.document_id,
+          grant.membership_epoch,
+          grant.grant_id
+        ],
+        &(is_binary(&1) and &1 != "")
+      ) and is_integer(grant.expires_at) and grant.expires_at > 0 and
+        is_list(grant.actions) and grant.actions != [] and
+        Enum.all?(grant.actions, &(&1 in @actions)) and grant.actions == Enum.u
niq(grant.actions)
+
+    if valid, do: :ok, else: {:error, :invalid_external_grant}
+  end
+
+  defp configured_organization_id do
+    case CommonplaceNext.Organization.configured() do
+      {:ok, organization} -> {:ok, organization.id}
+      _unavailable -> {:error, :unknown_cell}
+    end
+  end
+
+  defp workspace_hosts(organization_id) do
+    organization_id
+    |> Identity.space()
+    |> Map.fetch!(:workspace_cell_id)
+    |> CellSupervisor.hosts()
+  end
+
+  defp create_record(hosts, grant) do
+    id = document_id(grant.organization_id, grant.grant_id)
+    operation_id = "organization:external-grant:create:" <> grant.grant_id
+
+    with {:ok, host} <-
+           Hosts.create_document(hosts, id,
+             home_cell_id: Identity.space(grant.organization_id).authority_cell
_id,
+             client_id: Author.client_id(operation_id)
+           ),
+         {:ok, _snapshot} <- write_new(host, id, operation_id, encode(grant)) d
o
+      :ok
+    else
+      {:error, %{kind: :already_exists}} -> {:error, :grant_already_exists}
+      {:error, reason} -> {:error, reason}
+    end
+  end
+
+  defp append_index(hosts, grant) do
+    id = index_document_id(grant.organization_id, grant.grantee_cell_id)
+    operation_id = "organization:external-grant:index:" <> grant.grant_id
+
+    case Hosts.open_document(hosts, id, client_id: Author.client_id(operation_i
d)) do
+      {:ok, host} -> append(host, id, operation_id, "- grant-id: #{grant.grant_
id}\n")
+      {:error, %{kind: :log_not_found}} -> create_index(hosts, id, grant, opera
tion_id)
+      {:error, reason} -> {:error, reason}
+    end
+  end
+
+  defp create_index(hosts, id, grant, operation_id) do
+    markdown = "# external grants\n\n- grant-id: #{grant.grant_id}\n"
+
+    with {:ok, host} <-
+           Hosts.create_document(hosts, id,
+             home_cell_id: Identity.space(grant.organization_id).authority_cell
_id,
+             client_id: Author.client_id(operation_id)
+           ),
+         {:ok, _snapshot} <- write_new(host, id, operation_id, markdown) do
+      :ok
+    end
+  end
+
+  defp append_revocation(host, grant) do
+    id = document_id(grant.organization_id, grant.grant_id)
+    operation_id = "organization:external-grant:revoke:" <> grant.grant_id
+
+    if grant.revoked do
+      :ok
+    else
+      append(host, id, operation_id, "- revoked: true\n")
+    end
+  end
+
+  defp append(host, _document_id, operation_id, text) do
+    with {:ok, snapshot} <- DocHost.snapshot(host),
+         {:ok, current} <- Markdown.text(snapshot.content),
+         {:ok, [command]} <-
+           Markdown.edit(
+             snapshot.content,
+             snapshot.content_head,
+             [{:insert, byte_size(current), text}],
+             operation_id
+           ),
+         {:ok, _receipt} <-
+           DocHost.apply_content_edit(host, command, client_id: Author.client_i
d(operation_id)) do
+      :ok
+    end
+  end
+
+  defp write_new(host, document_id, operation_id, markdown) do
+    case Markdown.new_content(operation_id, markdown) do
+      [command] ->
+        with {:ok, _receipt} <-
+               DocHost.apply_content_edit(host, command,
+                 epoch_id: "organization:external-grant:" <> document_id,
+                 client_id: Author.client_id(operation_id)
+               ),
+             {:ok, snapshot} <- DocHost.snapshot(host) do
+          {:ok, snapshot}
+        end
+
+      [] ->
+        {:error, :empty_external_grant_record}
+    end
+  end
+
+  defp grant_ids(hosts, organization_id, grantee_cell_id) do
+    id = index_document_id(organization_id, grantee_cell_id)
+
+    case Hosts.open_document(hosts, id, client_id: 1) do
+      {:ok, host} ->
+        with {:ok, snapshot} <- DocHost.snapshot(host),
+             {:ok, markdown} <- Markdown.text(snapshot.content) do
+          ids =
+            Regex.scan(~r/^- grant-id: (\S+)$/m, markdown, capture: :all_but_fi
rst)
+            |> List.flatten()
+
+          if ids == [], do: {:error, :absent}, else: {:ok, ids}
+        end
+
+      {:error, %{kind: :log_not_found}} ->
+        {:error, :absent}
+
+      {:error, reason} ->
+        {:error, reason}
+    end
+  end
+
+  defp fetch_from_hosts(hosts, organization_id, grant_id) do
+    id = document_id(organization_id, grant_id)
+
+    case Hosts.open_document(hosts, id, client_id: 1) do
+      {:ok, host} ->
+        with {:ok, snapshot} <- DocHost.snapshot(host),
+             {:ok, markdown} <- Markdown.text(snapshot.content),
+             {:ok, grant} <- decode(markdown) do
+          {:ok, grant, host}
+        end
+
+      {:error, %{kind: :log_not_found}} ->
+        {:error, :absent}
+
+      {:error, reason} ->
+        {:error, reason}
+    end
+  end
+
+  defp classify_admission(grants) do
+    now = System.system_time(:second)
+
+    case Enum.find(grants, &(!&1.revoked and &1.expires_at > now)) do
+      %__MODULE__{} = grant ->
+        {:ok, grant}
+
+      nil ->
+        cond do
+          grants == [] -> {:error, :unknown_cell}
+          Enum.any?(grants, & &1.revoked) -> {:error, :grant_revoked}
+          true -> {:error, :grant_expired}
+        end
+    end
+  end
+
+  defp index_document_id(organization_id, grantee_cell_id),
+    do: Identity.derive(organization_id, :external_grant, "index:" <> grantee_c
ell_id)
+
+  defp encode(grant) do
+    actions = Enum.map_join(grant.actions, ",", &Atom.to_string/1)
+
+    """
+    # external document grant
+
+    - organization-id: #{grant.organization_id}
+    - grantee-cell-id: #{grant.grantee_cell_id}
+    - document-id: #{grant.document_id}
+    - actions: #{actions}
+    - membership-epoch: #{grant.membership_epoch}
+    - expires-at: #{grant.expires_at}
+    - grant-id: #{grant.grant_id}
+    - revoked: false
+    """
+  end
+
+  defp decode(markdown) do
+    with {:ok, organization_id} <- field(markdown, ~r/^- organization-id: (\S+)
$/m),
+         {:ok, grantee_cell_id} <- field(markdown, ~r/^- grantee-cell-id: (\S+)
$/m),
+         {:ok, document_id} <- field(markdown, ~r/^- document-id: (\S+)$/m),
+         {:ok, action_text} <- field(markdown, ~r/^- actions: (\S+)$/m),
+         {:ok, membership_epoch} <- field(markdown, ~r/^- membership-epoch: (\S
+)$/m),
+         {:ok, expires_at} <- integer_field(markdown, ~r/^- expires-at: ([0-9]+
)$/m),
+         {:ok, grant_id} <- field(markdown, ~r/^- grant-id: (\S+)$/m),
+         {:ok, actions} <- decode_actions(action_text) do
+      grant = %__MODULE__{
+        organization_id: organization_id,
+        grantee_cell_id: grantee_cell_id,
+        document_id: document_id,
+        actions: actions,
+        membership_epoch: membership_epoch,
+        expires_at: expires_at,
+        grant_id: grant_id,
+        revoked: Regex.match?(~r/^- revoked: true$/m, markdown)
+      }
+
+      with :ok <- validate(grant), do: {:ok, grant}
+    else
+      _ -> {:error, :corrupt_external_grant}
+    end
+  end
+
+  defp field(markdown, pattern) do
+    case Regex.run(pattern, markdown) do
+      [_line, value] -> {:ok, value}
+      _ -> {:error, :missing_field}
+    end
+  end
+
+  defp integer_field(markdown, pattern) do
+    with {:ok, value} <- field(markdown, pattern), do: {:ok, String.to_integer(
value)}
+  end
+
+  defp decode_actions(text) do
+    actions = String.split(text, ",", trim: true) |> Enum.map(&verb_atom/1)
+    if Enum.all?(actions, &(&1 in @actions)), do: {:ok, actions}, else: {:error
, :invalid_actions}
+  end
+
+  defp verb_atom(verb), do: Enum.find(@actions, &(Atom.to_string(&1) == verb))
+end
