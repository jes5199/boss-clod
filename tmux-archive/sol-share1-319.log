+
+  defp configured_organization_id do
+    {:ok, organization} = Organization.configured()
+    organization.id
+  end
+
+  defp ok!({:ok, value}), do: value
+
+  defp restart_realm(attempts \\ 20)
+  defp restart_realm(0), do: raise("realm restart exhausted")
+
+  defp restart_realm(attempts) do
+    case Supervisor.restart_child(CommonplaceNext.Supervisor, Realm) do
