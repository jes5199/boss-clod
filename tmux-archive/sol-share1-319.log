+  alias CommonplaceNext.Workspace.Seed
+  alias CommonplaceNext.{Organization, Realm}
+  alias CommonplaceNext.EditorPlacementTestHelper
+
+  @organization_2_id "commonplace-next-share-1-organization-2"
+  @foreign_member "foreign-owner@example.test"
+  @actions [:"document.sync.summary"]
+
+  setup do
+    :ok = stop_realm()
+    stop_sqlite_children()
+    data_dir = CommonplaceNext.TestFixtures.unique_tmp_root("share-1")
+    File.mkdir_p!(data_dir)
+    previous_log = Application.get_env(:commonplace_log, SQLite)
+    Application.put_env(:commonplace_log, SQLite, data_dir: data_dir)
+    :ok = restart_realm()
+
+    on_exit(fn ->
+      :ok = stop_realm()
+      stop_sqlite_children()
+      restore_env(:commonplace_log, SQLite, previous_log)
+      File.rm_rf!(data_dir)
+      :ok = restart_realm()
+    end)
+
+    {:ok, organization} = Organization.configured()
+    {:ok, hosts} = CellSupervisor.hosts(Identity.space(organization.id).workspa
ce_cell_id)
+    owner_entry = EditorPlacementTestHelper.first_entry()
+
+    {:ok, owner} =
+      Membership.resolve_owner(organization, hosts: hosts, member_id: owner_ent
ry.login)
+
+    epoch = Membership.derive_membership_epoch(@organization_2_id, @foreign_mem
ber, 1)
+    foreign = EditorPlacement.entry(@organization_2_id, @foreign_member, 1)
+
+    %{
+      owner: owner,
+      owner_entry: owner_entry,
+      foreign: foreign,
+      epoch: epoch,
+      document_id: Seed.ids().welcome_document_id,
+      other_document_id: Seed.ids().architecture_document_id
+    }
+  end
+
+  test "S1 base refusal, grant scope, and revoke are four ordered observations"
, context do
+    cell_id = context.foreign.cell_id
+
+    base = Credentials.bootstrap(cell_id, "127.0.0.1", Gateway.port())
+    assert base == {:error, :invalid_bootstrap_request}
+    IO.puts("S1.1 foreign cell id: #{cell_id}")
+    IO.puts("S1.2 base bootstrap: #{inspect(base)}")
+
+    {:ok, grant} = create_grant(context)
+    {:ok, bootstrap} = Credentials.bootstrap(cell_id, "127.0.0.1", Gateway.port
())
+
+    assert bootstrap["scope"] == %{
+             "kind" => "document_grant",
+             "grant_id" => grant.grant_id,
+             "documents" => [context.document_id],
+             "actions" => Enum.map(@actions, &Atom.to_string/1)
+           }
+
+    IO.puts("S1.3 granted bootstrap scope: #{inspect(bootstrap["scope"])}")
+
+    assert {:ok, %{revoked: true}} = ExternalGrant.revoke(context.owner, grant.
grant_id)
+    revoked = Credentials.bootstrap(cell_id, "127.0.0.1", Gateway.port())
+    assert revoked == {:error, :grant_revoked}
+    refute revoked == {:error, :invalid_bootstrap_request}
+    IO.puts("S1.4 revoked bootstrap: #{inspect(revoked)}")
+  end
+
+  test "S2 document_grant refuses D2 and mints only the exact action granted fo
r D", context do
+    {:ok, grant} = create_grant(context)
+    options = client_options(context.foreign.cell_id)
+
+    d2 = document_address(context.other_document_id)
+    d = document_address(context.document_id)
+
+    assert {:error, %Error{code: :unentitled}} =
+             request(context.foreign.cell_id, d2, options)
+
+    assert {:ok, %Response{outcome: {:ok, _value}}} =
+             request(context.foreign.cell_id, d, options)
+
+    assert grant.actions == @actions
+
+    assert {:ok, authorized} =
+             ExternalGrant.authorize(
+               context.foreign.cell_id,
+               context.document_id,
+               "document.sync.summary"
+             )
+
+    assert authorized.actions == @actions
+    IO.puts("S2 D2: {:error, :unentitled}")
+    IO.puts("S2 D actions: #{inspect(authorized.actions)}")
+  end
+
+  test "S3 configured neighbour bootstraps and grants exactly as before", conte
xt do
+    placed_bootstrap =
+      Credentials.bootstrap(context.owner_entry.cell_id, "127.0.0.1", Gateway.p
ort())
+
+    assert {:ok, placed} = placed_bootstrap
+    refute Map.has_key?(placed, "scope")
+
+    placed_options = client_options(context.owner_entry.cell_id)
+
+    assert {:ok, %Response{outcome: {:ok, _value}}} =
+             request(
+               context.owner_entry.cell_id,
+               document_address(context.document_id),
+               placed_options
+             )
+
+    IO.puts("S3 placed bootstrap shape: unscoped; document_grant: admitted")
+  end
+
+  @tag :s4
+  test "S4 revoke precedes bootstrap and document mint while an issued token li
ves", context do
+    {:ok, grant} = create_grant(context)
+    external_options = client_options(context.foreign.cell_id)
+    mint_id = Router.request_id()
+
+    {:ok, issued} =
+      DirectoryIssuer.issue_capability(
+        "document.sync.summary",
+        mint_id,
+        context.foreign.cell_id,
+        Identity.space(context.owner.organization_id).workspace_cell_id,
+        context.document_id
+      )
+
+    ground = %Ground{
+      source_cell: context.foreign.cell_id,
+      target_cell: Identity.space(context.owner.organization_id).workspace_cell
_id,
+      resource_kind: "document",
+      resource_id: context.document_id,
+      operation: "document.sync.summary",
+      time_unix: System.system_time(:second),
+      contract: nil,
+      policy: :grant
+    }
+
+    assert BiscuitRuntime.authorize(issued.token, issued.public_key, ground) ==
 :authorized
+    assert {:ok, %{revoked: true}} = ExternalGrant.revoke(context.owner, grant.
grant_id)
+
+    assert Credentials.bootstrap(context.foreign.cell_id, "127.0.0.1", Gateway.
port()) ==
+             {:error, :grant_revoked}
+
+    assert {:error, %Error{code: :revoked}} =
+             request(
+               context.foreign.cell_id,
+               document_address(context.document_id),
+               external_options
+             )
+
+    assert BiscuitRuntime.authorize(issued.token, issued.public_key, ground) ==
 :authorized
+    assert issued.expiry - issued.nbf == 60
+    IO.puts("S4 revoked bootstrap: grant_revoked; document_grant: revoked befor
e mint")
+    IO.puts("S4 pre-revoke token remains valid for [nbf=#{issued.nbf}, expiry=#
{issued.expiry})")
+  end
+
+  defp create_grant(context) do
+    ExternalGrant.create(context.owner, %{
+      grantee_cell_id: context.foreign.cell_id,
+      document_id: context.document_id,
+      actions: @actions,
+      membership_epoch: context.epoch,
+      expires_at: System.system_time(:second) + 3_600,
+      grant_id: Router.request_id()
+    })
+  end
+
+  defp request(source_cell_id, target, options) do
+    Gateway.Client.request(
+      source_cell_id,
+      target,
+      "document.sync.summary",
+      %{},
+      Keyword.merge(options, request_id: Router.request_id(), grant: :document_
grant)
+    )
+  end
+
+  defp document_address(document_id) do
+    Address.document(Identity.space(configured_organization_id()).workspace_cel
l_id, document_id)
+    |> ok!()
+  end
+
+  defp client_options(cell_id) do
+    token = :crypto.strong_rand_bytes(32) |> Base.url_encode64(padding: false)
+    {:ok, material} = Credentials.bootstrap(cell_id, "127.0.0.1", Gateway.port(
), token)
+    client = material["transport_client"]
