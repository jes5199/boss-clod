config :commonplace_next, CommonplaceNext.Realm.Keystore,
  roots: [
    %{
      root_key_id: 1,
      algorithm: "ed25519",
      public_key: String.duplicate("ab", 32),
      status: "active",
      issuer: %{
        "purpose" => "realm.capability",
        "realm" => "somewhere-else",
        "operations" => ["directory.list", "directory.resolve", "cell.open", "do
cument.sync.summary", "document.sync.offer"]
      }
    }
  ]
CONFIG
  if [ "$(git -C "$root" hash-object "$config_subject")" = "$config_before" ]; t
hen
    printf 'TEST FAIL: config-only-second-root mutator changed nothing; the arm
tested nothing\n' >&2
