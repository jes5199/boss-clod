#!/usr/bin/env bash
# Regression and falsifier for the shipped trust-root inventory gate.
#
# ⭐ A GATE YOU HAVE NEVER SEEN FAIL IS NOT KNOWN TO WORK. Both mandatory red sh
apes are driven
# through a REAL BOOT of the whole application, never against a re-implementatio
n of the
# measurement: every arm calls the shipped `Mix.Tasks.CommonplaceNext.CheckTrust
Roots.measure/0`.
# ⛔ THE STRONGEST ARM IS `config-only-second-root`: it edits a TRACKED CONFIG F
ILE and nothing else,
# runs the shipped gate through its shipped door, and requires red. That is the
exact hazard --
# a second trust root arriving with NO SOURCE DIFF.
set -uo pipefail

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
gate="$root/bin/check-trust-root-inventory.sh"

if [ "$#" -ne 0 ]; then
  printf 'TEST BLIND: usage: %s\n' "$(basename "$0")" >&2
  exit 2
fi
if [ ! -x "$gate" ]; then
  printf 'TEST RED: candidate gate missing or not executable at %s\n' "$gate" >&
2
  exit 1
fi
if ! command -v mix >/dev/null 2>&1; then
  printf 'TEST BLIND: mix is unavailable; no arm can boot a Realm\n' >&2
  exit 2
fi

tmp=$(mktemp -d)
config_subject="config/dev.exs"
config_before=$(git -C "$root" hash-object "$config_subject")

restore_config() {
  git -C "$root" checkout -- "$config_subject" 2>/dev/null || true
  local now
  now=$(git -C "$root" hash-object "$config_subject" 2>/dev/null || echo missing
)
  if [ "$now" != "$config_before" ]; then
    printf 'TEST BLIND: %s was NOT restored (%s != %s); the working tree is dirt
y.\n' \
      "$config_subject" "$now" "$config_before" >&2
    exit 2
  fi
}
# ⛔ RESTORE ON EVERY PATH, including the ones that are not the happy one.
trap 'restore_config; rm -rf "$tmp"' EXIT INT TERM

failures=0
arms_run=0
self_checks_run=0

# run_probe <name> <expected_result> <expected_text> <injection-elixir> [forbidd
en_text]
#
# The injection runs BEFORE the application starts, so the second root is presen
t from boot --
# not put into a keystore that had already loaded without it.
run_probe() {
  local name="$1" expected="$2" expected_text="$3" injection="$4" forbidden="${5
:-}"
  local script="$tmp/$name.exs" out result
  cat > "$script" <<EOF
$injection
{:ok, _} = Application.ensure_all_started(:commonplace_next)
Process.sleep(400)

case Mix.Tasks.CommonplaceNext.CheckTrustRoots.measure() do
  {:ok, lines} ->
    Enum.each(lines, &IO.puts/1)
    IO.puts("RESULT=OK")

  {:red, lines, problems} ->
    Enum.each(lines, &IO.puts/1)
    Enum.each(problems, &IO.puts/1)
    IO.puts("RESULT=RED")

  {:blind, message} ->
    IO.puts("INSTRUMENT BLIND: #{'#{message}'}")
    IO.puts("RESULT=BLIND")
end
EOF
  arms_run=$((arms_run + 1))
  out=$( (cd "$root" && mix run --no-start "$script") 2>&1 )
  result=$(printf '%s\n' "$out" | sed -n 's/^RESULT=//p' | tail -1)
  printf 'CASE %s result=%s expected=%s\n' "$name" "${result:-<none>}" "$expecte
d"
  printf '%s\n' "$out" | grep -E '^(TRUST|ACTIVE|KEYSTORE|  ROOT|SECOND|FOREIGN|
VERDICT|INSTRUMENT)' || true
  if [ "$result" != "$expected" ] || ! grep -Fq -- "$expected_text" <<< "$out";
then
    printf 'TEST FAIL: %s expected result=%s and text=%s\n' "$name" "$expected"
"$expected_text" >&2
    return 1
  fi
  if [ -n "$forbidden" ] && grep -Fq -- "$forbidden" <<< "$out"; then
    printf 'TEST FAIL: %s discriminator absent -- forbidden text present: %s\n'
"$name" "$forbidden" >&2
    return 1
  fi
}

second_root_literal='%{
  root_key_id: 1,
  algorithm: "ed25519",
  public_key: String.duplicate("ab", 32),
  status: "active",
  issuer: %{
    "purpose" => "realm.capability",
    "realm" => "somewhere-else",
    "operations" => ["directory.list", "directory.resolve", "cell.open", "docume
nt.sync.summary", "document.sync.offer"]
