#!/usr/bin/env bash
# Gate: the declared trust-root inventory of a BOOTED Realm.
# Exit 0 = declared inventory; 1 = a second or foreign trust root; 2 = instrumen
t blind.
#
# ⭐ WHY THIS ONE BOOTS INSTEAD OF READING SOURCE. `Realm.Keystore.child_spec/1`
 merges
# `Application.get_env(:commonplace_next, Realm.Keystore, [])` into its start op
tions, so a second
# trust root arrives through `roots:` or `path:` as a CONFIG-ONLY CHANGE WITH NO
 DIFF. The three
# static literals cannot see it. ⛔ A GATE INSTALLED AFTER THE TEMPTATION IS INS
TALLED TOO LATE.
#
# The measurement itself lives in the Mix task, so the falsifier drives the SAME
 function rather
# than a copy of it. This script is the operator's door and the exit-code contra
ct.
set -uo pipefail

if [ "$#" -ne 0 ]; then
  printf 'INSTRUMENT BLIND: usage: %s\n' "$(basename "$0")" >&2
  printf 'VERDICT: TRUST ROOT INVENTORY BLIND\n' >&2
  exit 2
fi

root=${TRUST_ROOT_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)}

if ! command -v mix >/dev/null 2>&1; then
  printf 'INSTRUMENT BLIND: mix is unavailable, so no Realm can be booted to mea
sure\n' >&2
  printf 'VERDICT: TRUST ROOT INVENTORY BLIND\n' >&2
  exit 2
fi

out=$(cd "$root" && mix commonplace_next.check_trust_roots 2>&1)
rc=$?
printf '%s\n' "$out"

case "$rc" in
  0)
    # ⛔ rc 0 ALONE IS SATISFIED BY A TASK THAT PRINTED NOTHING. The green must
carry the verdict
    # line, or a task that failed to measure and exited cleanly reads as a confi
rmed inventory.
    if ! printf '%s' "$out" | grep -q '^VERDICT: TRUST ROOT INVENTORY OK'; then
      printf 'INSTRUMENT BLIND: the task exited 0 without printing a trust root
verdict\n' >&2
      printf 'VERDICT: TRUST ROOT INVENTORY BLIND\n' >&2
      exit 2
    fi
    exit 0 ;;
  1) exit 1 ;;
  *)
    printf 'VERDICT: TRUST ROOT INVENTORY BLIND\n' >&2
    exit 2 ;;
esac

