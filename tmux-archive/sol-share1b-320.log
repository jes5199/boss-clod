    return 1
  fi
  printf 'CASE %s correctly FAILED (rc=%s).\n' "$label" "$rc"
}

self_check no-op-injection-self-check \
  'an UNMUTATED boot satisfies a red expectation, so the red arms assert nothing
' \
  no-op-injection-self-check RED 'the Keystore start options carry [:roots]' ':o
k' \
  || failures=$((failures + 1))

self_check cross-injection-self-check \
  'the path: arm credits itself for a red caused by the roots: injection' \
  cross-injection-self-check RED 'the Keystore start options carry [:path]' \
"Application.put_env(:commonplace_next, CommonplaceNext.Realm.Keystore, roots: [
$second_root_literal])" \
  || failures=$((failures + 1))

if [ "$arms_run" -eq 0 ] || [ "$self_checks_run" -eq 0 ]; then
  printf 'TEST BLIND: %s arm(s) and %s self-check(s) executed; an empty arm popu
lation is not a pass.\n' \
    "$arms_run" "$self_checks_run" >&2
  exit 2
fi
if [ "$failures" -eq 0 ]; then
  printf 'TEST VERDICT: TRUST ROOT FALSIFIER OK -- %s arms and %s self-checks ex
ecuted; both mandatory red shapes (roots: and path:) demonstrated through a real
 boot, and a config-only second root demonstrated through the shipped gate.\n' \
    "$arms_run" "$self_checks_run"
  exit 0
fi
printf 'TEST VERDICT: TRUST ROOT FALSIFIER RED -- %s case(s) failed.\n' "$failur
es" >&2
exit 1

