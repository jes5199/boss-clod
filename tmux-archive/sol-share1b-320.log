  fi
  arms_run=$((arms_run + 1))
  out=$(bash "$gate" 2>&1) || rc=$?
  restore_config
  printf 'CASE config-only-second-root rc=%s expected=1\n' "$rc"
  printf '%s\n' "$out" | grep -E '^(TRUST|ACTIVE|KEYSTORE|  ROOT|SECOND|FOREIGN|
VERDICT)' || true
  if [ "$rc" -ne 1 ] || ! grep -Fq -- 'SECOND TRUST ROOT CONFIGURED' <<< "$out";
