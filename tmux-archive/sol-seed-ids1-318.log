+defmodule SeedIdsI2EquivalenceTest do
+  use ExUnit.Case, async: false
+
+  alias CommonplaceNext.Organization
+  alias CommonplaceNext.Organization.Identity
+  alias CommonplaceNext.Workspace.Seed
+  alias CommonplaceNext.WorkspaceCell
+
+  test "measure-log-growth and telemetry ids equal the legacy projection" do
+    legacy = Seed.ids()
+    {:ok, organization} = Organization.configured()
+    space = Identity.space(organization)
+    descriptor = WorkspaceCell.descriptor()
+    welcome_document_id = Identity.seed_document_id(space.organization_id, "wel
come")
+
+    assert welcome_document_id == legacy.welcome_document_id
+    assert space.root_directory_id == legacy.root_directory_id
+    assert descriptor.cell_id == legacy.workspace_cell_id
+    assert descriptor.root_directory_id == legacy.root_directory_id
+  end
+end
